@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["CreateNewEquipment"];
}

<div class="equipment-editor-page">

    <section class="equipment-editor-header mb-4">

        <div class="equipment-editor-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <h1 class="equipment-editor-title mb-0">
                @Localizer["CreateNewEquipment"]
            </h1>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="equipment-editor-card">

            <div class="px-4 pt-4">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-0"
                     role="alert">
                </div>

            </div>

            <section class="equipment-editor-section">

                <h2 class="equipment-editor-section-title">
                    @Localizer["Equipment"]
                </h2>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label">

                            @Localizer["EquipmentName"]

                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               autofocus />

                        <span asp-validation-for="Name"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="SerialNumber"
                               class="form-label">

                            @Localizer["SerialNumber"]

                        </label>

                        <input asp-for="SerialNumber"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="SerialNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CategoryId"
                               class="form-label">

                            @Localizer["Category"]

                        </label>

                        <select asp-for="CategoryId"
                                class="form-select"
                                asp-items="ViewBag.CategoryId">

                            <option value="">
                                @Localizer["SelectCategory"]
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PurchaseDate"
                               class="form-label">

                            @Localizer["PurchaseDate"]

                        </label>

                        <input asp-for="PurchaseDate"
                               type="date"
                               class="form-control"
                               data-val="true"
                               data-val-required="@Localizer["PurchaseDateRequired"]" />

                        <span asp-validation-for="PurchaseDate"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PurchasePrice"
                               class="form-label">

                            @Localizer["PurchasePrice"]

                        </label>

                        <input asp-for="PurchasePrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="PurchasePrice"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["Status"]
                        </label>

                        <div class="equipment-availability-box">

                            <input asp-for="IsAvailable"
                                   class="form-check-input" />

                            <label asp-for="IsAvailable"
                                   class="form-check-label">

                                @Localizer["AvailableForBorrowing"]

                            </label>

                        </div>

                    </div>

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label">

                            @Localizer["Description"]

                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <section class="equipment-editor-section">

                <h2 class="equipment-editor-section-title">
                    @Localizer["EquipmentImage"]
                </h2>

                <div class="equipment-image-upload-area">

                    <label for="imageFile"
                           class="form-label">

                        @Localizer["EquipmentImage"]

                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div class="form-text mt-2">
                        @Localizer["ImageUploadRequirements"]
                    </div>

                    @Html.ValidationMessage(
                        "imageFile",
                        null,
                        new
                        {
                            @class = "text-danger small"
                        }
                    )

                    <div id="imagePreviewContainer"
                         class="equipment-new-image-preview">

                        <img id="imagePreview"
                             class="equipment-image-preview"
                             src=""
                             alt="@Localizer["EquipmentImage"]" />

                    </div>

                </div>

            </section>

            <div class="equipment-editor-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary px-4">

                    @Localizer["AddEquipment"]

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const imageInput =
                    document.getElementById("imageFile");

                const previewContainer =
                    document.getElementById(
                        "imagePreviewContainer"
                    );

                const previewImage =
                    document.getElementById(
                        "imagePreview"
                    );

                if (
                    !imageInput ||
                    !previewContainer ||
                    !previewImage
                ) {
                    return;
                }

                imageInput.addEventListener(
                    "change",
                    function () {
                        const selectedFile =
                            this.files?.[0];

                        previewImage.removeAttribute(
                            "src"
                        );

                        previewContainer.style.display =
                            "none";

                        if (
                            !selectedFile ||
                            !selectedFile.type.startsWith(
                                "image/"
                            )
                        ) {
                            return;
                        }

                        const imageUrl =
                            URL.createObjectURL(
                                selectedFile
                            );

                        previewImage.src = imageUrl;

                        previewContainer.style.display =
                            "block";

                        previewImage.onload =
                            function () {
                                URL.revokeObjectURL(
                                    imageUrl
                                );
                            };
                    }
                );
            }
        );
    </script>

}