@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CreateNewEquipment"];
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">

                <h1 class="h4 mb-0">
                    @Localizer["CreateNewEquipment"]
                </h1>

            </div>

            <div class="card-body">

                <form asp-action="Create" method="post" enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Name" class="form-label">

                            @Localizer["EquipmentName"]

                        </label>

                        <input asp-for="Name" class="form-control" />

                        <span asp-validation-for="Name" class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="CategoryId" class="form-label">

                            @Localizer["Category"]

                        </label>

                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">

                            <option value="">
                                @Localizer["SelectCategory"]
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId" class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="SerialNumber" class="form-label">

                            @Localizer["SerialNumber"]

                        </label>

                        <input asp-for="SerialNumber" class="form-control" />

                        <span asp-validation-for="SerialNumber" class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Description" class="form-label">

                            @Localizer["Description"]

                        </label>

                        <textarea asp-for="Description" class="form-control" rows="3">
                        </textarea>

                        <span asp-validation-for="Description" class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="PurchaseDate" class="form-label">

                            @Localizer["PurchaseDate"]

                        </label>

                        <input asp-for="PurchaseDate" type="date" class="form-control" data-val="true"
                               data-val-required="@Localizer["PurchaseDateRequired"]" />

                        <span asp-validation-for="PurchaseDate" class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="PurchasePrice" class="form-label">

                            @Localizer["PurchasePrice"]

                        </label>

                        <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />

                        <span asp-validation-for="PurchasePrice" class="text-danger">
                        </span>

                    </div>

                    <div class="form-check mb-3">

                        <input asp-for="IsAvailable" class="form-check-input" />

                        <label asp-for="IsAvailable" class="form-check-label">

                            @Localizer["AvailableForBorrowing"]

                        </label>

                    </div>

                    <div class="mb-3">

                        <label for="imageFile" class="form-label">

                            @Localizer["EquipmentImage"]

                        </label>

                        <input type="file" id="imageFile" name="imageFile" class="form-control"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                        <div class="form-text">
                            @Localizer["ImageUploadRequirements"]
                        </div>

                        @Html.ValidationMessage(
                            "imageFile",
                            null,
                            new
                            {
                                @class = "text-danger"
                            }
                        )

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit" class="btn btn-primary">

                            @Localizer["AddEquipment"]

                        </button>

                        <a asp-action="Index" class="btn btn-secondary">

                            @Localizer["BackToList"]

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}