@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["EquipmentDetails"];
}

<div class="equipment-record-page">

    <section class="equipment-record-header mb-4">

        <div class="equipment-record-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="equipment-record-title mb-1">
                    @Localizer["EquipmentDetails"]
                </h1>

                <p class="equipment-record-subtitle mb-0">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <section class="equipment-record-card">

        <div class="row g-0">

            <div class="col-lg-6">

                <div class="equipment-record-image-area">

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ImagePath))
                    {
                        <div class="text-center">

                            <a href="@Model.ImagePath"
                               target="_blank"
                               rel="noopener noreferrer">

                                <img src="@Model.ImagePath"
                                     alt="@Localizer[
                                         "EquipmentImageAlt",
                                         Model.Name
                                     ]"
                                     class="equipment-record-image" />

                            </a>

                            <p class="text-muted small mt-3 mb-0">
                                @Localizer["ClickImageForFullSize"]
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="equipment-record-placeholder">

                            <span class="equipment-record-placeholder-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     aria-hidden="true">

                                    <rect x="3"
                                          y="3"
                                          width="18"
                                          height="18"
                                          rx="2" />

                                    <circle cx="8.5"
                                            cy="8.5"
                                            r="1.5" />

                                    <path d="m21 15-5-5L5 21" />

                                </svg>

                            </span>

                            <p class="fw-semibold mb-0">
                                @Localizer["NoImageForEquipment"]
                            </p>

                        </div>
                    }

                </div>

            </div>

            <div class="col-lg-6">

                <div class="equipment-record-information">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3 flex-wrap">

                        <div>

                            <h2 class="equipment-record-name">
                                @Model.Name
                            </h2>

                            <span class="equipment-record-serial">
                                @Model.SerialNumber
                            </span>

                        </div>

                        @if (Model.IsAvailable)
                        {
                            <span class="equipment-record-status available">
                                @Localizer["Available"]
                            </span>
                        }
                        else
                        {
                            <span class="equipment-record-status borrowed">
                                @Localizer["Borrowed"]
                            </span>
                        }

                    </div>

                    <dl class="equipment-record-list">

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["EquipmentName"]
                            </dt>

                            <dd class="equipment-record-value">
                                @Model.Name
                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["SerialNumber"]
                            </dt>

                            <dd class="equipment-record-value">

                                <span class="equipment-record-serial">
                                    @Model.SerialNumber
                                </span>

                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["Category"]
                            </dt>

                            <dd class="equipment-record-value">

                                @if (Model.Category != null)
                                {
                                    <span class="equipment-record-category">
                                        @Model.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["Description"]
                            </dt>

                            <dd class="equipment-record-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Description)
                                    ? "-"
                                    : Model.Description)

                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["PurchaseDate"]
                            </dt>

                            <dd class="equipment-record-value">
                                @Model.PurchaseDate.ToString("d")
                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["PurchasePrice"]
                            </dt>

                            <dd class="equipment-record-value fw-bold">
                                @Model.PurchasePrice.ToString("N2")
                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["Status"]
                            </dt>

                            <dd class="equipment-record-value">

                                @if (Model.IsAvailable)
                                {
                                    <span class="equipment-record-status available">
                                        @Localizer["Available"]
                                    </span>
                                }
                                else
                                {
                                    <span class="equipment-record-status borrowed">
                                        @Localizer["Borrowed"]
                                    </span>
                                }

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <div class="equipment-record-footer">

            <div class="d-flex gap-2 flex-wrap">

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning px-4">

                        @Localizer["Edit"]

                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </section>

</div>