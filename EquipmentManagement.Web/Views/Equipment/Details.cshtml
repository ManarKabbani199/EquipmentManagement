@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EquipmentDetails"];
}

<div class="row justify-content-center">

    <div class="col-lg-9">

        <div class="card shadow-sm">

            <div class="card-header bg-info">

                <h1 class="h4 mb-0">
                    @Localizer["EquipmentDetails"]
                </h1>

            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="mb-4 text-center">

                        <a href="@Model.ImagePath"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@Model.ImagePath"
                                 alt="@Localizer["EquipmentImageAlt", Model.Name]"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-width:450px;
                                        max-height:350px;
                                        object-fit:contain;" />

                        </a>

                        <div class="text-muted mt-2">
                            @Localizer["ClickImageForFullSize"]
                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        @Localizer["NoImageForEquipment"]
                    </div>
                }

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        @Localizer["EquipmentName"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["SerialNumber"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.SerialNumber
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Description"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["PurchaseDate"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.PurchaseDate.ToString("d")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["PurchasePrice"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.PurchasePrice.ToString("N2")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Status"]
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success">
                                @Localizer["Available"]
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @Localizer["Borrowed"]
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Category"]
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Category?.Name ?? "-")
                    </dd>

                </dl>

            </div>

            <div class="card-footer">

                <div class="d-flex gap-2">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            @Localizer["Edit"]

                        </a>
                    }

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        @Localizer["BackToList"]

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>