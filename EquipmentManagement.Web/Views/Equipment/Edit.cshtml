@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EditEquipment"];

    var hasCurrentImage =
        !string.IsNullOrWhiteSpace(Model.ImagePath);
}

<style>
    .edit-equipment-header {
        position: relative;
        overflow: hidden;
        padding: 1.75rem;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(255, 255, 255, 0.2),
                transparent 35%
            ),
            linear-gradient(135deg, #0f172a, #d97706);
        border-radius: 1.2rem;
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.12);
    }

    .edit-equipment-header-content {
        position: relative;
        z-index: 1;
    }

    .edit-equipment-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
    }

    .edit-equipment-card {
        overflow: hidden;
        background: white;
        border: 0;
        border-radius: 1.1rem;
        box-shadow: 0 0.6rem 1.8rem rgba(15, 23, 42, 0.08);
    }

    .edit-form-section {
        padding: 1.5rem;
    }

    .edit-form-section + .edit-form-section {
        border-top: 1px solid #e2e8f0;
    }

    .edit-section-title {
        margin-bottom: 1.25rem;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
    }

    .edit-equipment-card .form-label {
        color: #334155;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .edit-equipment-card .form-control,
    .edit-equipment-card .form-select {
        min-height: 2.8rem;
        border-color: #cbd5e1;
        border-radius: 0.7rem;
    }

    .edit-equipment-card textarea.form-control {
        min-height: 7rem;
        resize: vertical;
    }

    .edit-equipment-card .form-control:focus,
    .edit-equipment-card .form-select:focus {
        border-color: #d97706;
        box-shadow: 0 0 0 0.2rem rgba(217, 119, 6, 0.14);
    }

    .edit-equipment-card .input-validation-error {
        border-color: #dc2626;
    }

    .validation-summary-valid {
        display: none;
    }

    .edit-availability-box {
        display: flex;
        gap: 0.8rem;
        min-height: 3.2rem;
        align-items: center;
        padding: 0.8rem 1rem;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 0.75rem;
    }

    .edit-availability-box .form-check-input {
        width: 1.2rem;
        height: 1.2rem;
        margin: 0;
        cursor: pointer;
    }

    .edit-availability-box .form-check-label {
        color: #166534;
        font-weight: 700;
        cursor: pointer;
    }

    .edit-image-area {
        padding: 1.25rem;
        background: #f8fafc;
        border: 1px dashed #94a3b8;
        border-radius: 1rem;
    }

    .edit-image-preview-container {
        margin-bottom: 1.25rem;
        text-align: center;
    }

    .edit-image-preview {
        width: 100%;
        max-width: 26rem;
        max-height: 19rem;
        object-fit: contain;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 0.9rem;
        box-shadow: 0 0.4rem 1rem rgba(15, 23, 42, 0.08);
    }

    .edit-no-image {
        display: flex;
        min-height: 10rem;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
        color: #64748b;
        background: #f1f5f9;
        border-radius: 0.85rem;
    }

    .edit-form-actions {
        padding: 1.25rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 575.98px) {
        .edit-equipment-header {
            padding: 1.3rem;
            border-radius: 1rem;
        }

        .edit-equipment-header-content {
            align-items: stretch !important;
            flex-direction: column;
        }

        .edit-equipment-header .btn {
            width: 100%;
        }

        .edit-form-section {
            padding: 1.2rem;
        }

        .edit-form-actions {
            flex-direction: column;
        }

        .edit-form-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="edit-equipment-page">

    <!-- عنوان الصفحة -->
    <section class="edit-equipment-header mb-4">

        <div class="edit-equipment-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="edit-equipment-title mb-1">
                    @Localizer["EditEquipment"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]
            </a>

        </div>

    </section>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <div class="edit-equipment-card">

            <!-- رقم المعدة -->
            <input type="hidden"
                   asp-for="Id" />

            <!-- أخطاء النموذج -->
            <div class="px-4 pt-4">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-0"
                     role="alert">
                </div>

            </div>

            <!-- المعلومات الأساسية -->
            <section class="edit-form-section">

                <h2 class="edit-section-title">
                    @Localizer["Equipment"]
                </h2>

                <div class="row g-4">

                    <!-- اسم المعدة -->
                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label">

                            @Localizer["EquipmentName"]
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- الرقم التسلسلي -->
                    <div class="col-md-6">

                        <label asp-for="SerialNumber"
                               class="form-label">

                            @Localizer["SerialNumber"]
                        </label>

                        <input asp-for="SerialNumber"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="SerialNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- التصنيف -->
                    <div class="col-md-6">

                        <label asp-for="CategoryId"
                               class="form-label">

                            @Localizer["Category"]
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select"
                                asp-items="ViewBag.CategoryId">
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- تاريخ الشراء -->
                    <div class="col-md-6">

                        <label asp-for="PurchaseDate"
                               class="form-label">

                            @Localizer["PurchaseDate"]
                        </label>

                        <input asp-for="PurchaseDate"
                               type="date"
                               class="form-control"
                               data-val="true"
                               data-val-required="@Localizer["PurchaseDateRequired"]" />

                        <span asp-validation-for="PurchaseDate"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- سعر الشراء -->
                    <div class="col-md-6">

                        <label asp-for="PurchasePrice"
                               class="form-label">

                            @Localizer["PurchasePrice"]
                        </label>

                        <input asp-for="PurchasePrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="PurchasePrice"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- حالة المعدة -->
                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["Status"]
                        </label>

                        <div class="edit-availability-box">

                            <input asp-for="IsAvailable"
                                   class="form-check-input" />

                            <label asp-for="IsAvailable"
                                   class="form-check-label">

                                @Localizer["AvailableForBorrowing"]
                            </label>

                        </div>

                    </div>

                    <!-- الوصف -->
                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label">

                            @Localizer["Description"]
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <!-- الصورة -->
            <section class="edit-form-section">

                <h2 class="edit-section-title">
                    @Localizer["EquipmentImage"]
                </h2>

                <div class="edit-image-area">

                    <!-- الصورة الحالية أو الجديدة -->
                    <div id="imagePreviewContainer"
                         class="edit-image-preview-container
                                @(hasCurrentImage ? "" : "d-none")">

                        <a id="imagePreviewLink"
                           href="@(hasCurrentImage ? Model.ImagePath : "#")"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img id="imagePreview"
                                 src="@(hasCurrentImage ? Model.ImagePath : "")"
                                 alt="@Localizer["EquipmentImageAlt", Model.Name]"
                                 class="edit-image-preview" />

                        </a>

                        <p id="imagePreviewTitle"
                           class="text-muted small mt-2 mb-0">

                            @Localizer["CurrentImage"]
                        </p>

                    </div>

                    <!-- يظهر عند عدم وجود صورة -->
                    <div id="noImageMessage"
                         class="edit-no-image
                                @(hasCurrentImage ? "d-none" : "")">

                        @Localizer["NoImageForEquipment"]

                    </div>

                    <!-- اختيار صورة جديدة -->
                    <label for="imageFile"
                           class="form-label">

                        @Localizer["SelectNewImage"]
                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div class="form-text mt-2">
                        @Localizer["KeepCurrentImageHelp"]
                    </div>

                    @Html.ValidationMessage(
                        "imageFile",
                        null,
                        new
                        {
                            @class = "text-danger small"
                        }
                    )

                </div>

            </section>

            <!-- الأزرار -->
            <div class="edit-form-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-warning px-4">

                    @Localizer["SaveChanges"]
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]
                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const imageInput =
                document.getElementById("imageFile");

            const previewContainer =
                document.getElementById("imagePreviewContainer");

            const previewLink =
                document.getElementById("imagePreviewLink");

            const previewImage =
                document.getElementById("imagePreview");

            const previewTitle =
                document.getElementById("imagePreviewTitle");

            const noImageMessage =
                document.getElementById("noImageMessage");

            let temporaryImageUrl = null;

            imageInput.addEventListener("change", function () {

                const selectedFile = this.files[0];

                if (!selectedFile) {
                    return;
                }

                if (!selectedFile.type.startsWith("image/")) {
                    return;
                }

                if (temporaryImageUrl) {
                    URL.revokeObjectURL(temporaryImageUrl);
                }

                temporaryImageUrl =
                    URL.createObjectURL(selectedFile);

                previewImage.src = temporaryImageUrl;
                previewLink.href = temporaryImageUrl;

                previewContainer.classList.remove("d-none");
                noImageMessage.classList.add("d-none");

                previewTitle.textContent =
                    selectedFile.name;

            });

            window.addEventListener("beforeunload", function () {

                if (temporaryImageUrl) {
                    URL.revokeObjectURL(temporaryImageUrl);
                }

            });

        });
    </script>

}