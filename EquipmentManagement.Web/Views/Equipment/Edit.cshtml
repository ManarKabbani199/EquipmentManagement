@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["EditEquipment"];

    var hasCurrentImage =
        !string.IsNullOrWhiteSpace(Model.ImagePath);
}

<div class="equipment-editor-page equipment-theme-edit">

    <section class="equipment-editor-header mb-4">

        <div class="equipment-editor-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="equipment-editor-title mb-1">
                    @Localizer["EditEquipment"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <div class="equipment-editor-card">

            <div class="px-4 pt-4">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-0"
                     role="alert">
                </div>

            </div>

            <section class="equipment-editor-section">

                <h2 class="equipment-editor-section-title">
                    @Localizer["Equipment"]
                </h2>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label">

                            @Localizer["EquipmentName"]

                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               autofocus />

                        <span asp-validation-for="Name"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="SerialNumber"
                               class="form-label">

                            @Localizer["SerialNumber"]

                        </label>

                        <input asp-for="SerialNumber"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="SerialNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CategoryId"
                               class="form-label">

                            @Localizer["Category"]

                        </label>

                        <select asp-for="CategoryId"
                                class="form-select"
                                asp-items="ViewBag.CategoryId">
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PurchaseDate"
                               class="form-label">

                            @Localizer["PurchaseDate"]

                        </label>

                        <input asp-for="PurchaseDate"
                               type="date"
                               class="form-control"
                               data-val="true"
                               data-val-required="@Localizer["PurchaseDateRequired"]" />

                        <span asp-validation-for="PurchaseDate"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PurchasePrice"
                               class="form-label">

                            @Localizer["PurchasePrice"]

                        </label>

                        <input asp-for="PurchasePrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="PurchasePrice"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["Status"]
                        </label>

                        <div class="equipment-availability-box">

                            <input asp-for="IsAvailable"
                                   class="form-check-input" />

                            <label asp-for="IsAvailable"
                                   class="form-check-label">

                                @Localizer["AvailableForBorrowing"]

                            </label>

                        </div>

                    </div>

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label">

                            @Localizer["Description"]

                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <section class="equipment-editor-section">

                <h2 class="equipment-editor-section-title">
                    @Localizer["EquipmentImage"]
                </h2>

                <div class="equipment-image-upload-area">

                    <div id="imagePreviewContainer"
                         class="equipment-current-image
                                @(hasCurrentImage ? "" : "d-none")">

                        <a id="imagePreviewLink"
                           href="@(hasCurrentImage ? Model.ImagePath : "#")"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img id="imagePreview"
                                 src="@(hasCurrentImage ? Model.ImagePath : "")"
                                 alt="@Localizer["EquipmentImageAlt", Model.Name]"
                                 class="equipment-image-preview" />

                        </a>

                        <p id="imagePreviewTitle"
                           class="text-muted small mt-2 mb-0">

                            @Localizer["CurrentImage"]

                        </p>

                    </div>

                    <div id="noImageMessage"
                         class="equipment-no-image
                                @(hasCurrentImage ? "d-none" : "")">

                        @Localizer["NoImageForEquipment"]

                    </div>

                    <label for="imageFile"
                           class="form-label">

                        @Localizer["SelectNewImage"]

                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div class="form-text mt-2">
                        @Localizer["KeepCurrentImageHelp"]
                    </div>

                    @Html.ValidationMessage(
                        "imageFile",
                        null,
                        new
                        {
                            @class = "text-danger small"
                        }
                    )

                </div>

            </section>

            <div class="equipment-editor-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-warning px-4">

                    @Localizer["SaveChanges"]

                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const imageInput =
                    document.getElementById("imageFile");

                const previewContainer =
                    document.getElementById(
                        "imagePreviewContainer"
                    );

                const previewLink =
                    document.getElementById(
                        "imagePreviewLink"
                    );

                const previewImage =
                    document.getElementById(
                        "imagePreview"
                    );

                const previewTitle =
                    document.getElementById(
                        "imagePreviewTitle"
                    );

                const noImageMessage =
                    document.getElementById(
                        "noImageMessage"
                    );

                if (
                    !imageInput ||
                    !previewContainer ||
                    !previewLink ||
                    !previewImage ||
                    !previewTitle ||
                    !noImageMessage
                ) {
                    return;
                }

                let temporaryImageUrl = null;

                imageInput.addEventListener(
                    "change",
                    function () {
                        const selectedFile =
                            this.files?.[0];

                        if (
                            !selectedFile ||
                            !selectedFile.type.startsWith(
                                "image/"
                            )
                        ) {
                            return;
                        }

                        if (temporaryImageUrl) {
                            URL.revokeObjectURL(
                                temporaryImageUrl
                            );
                        }

                        temporaryImageUrl =
                            URL.createObjectURL(
                                selectedFile
                            );

                        previewImage.src =
                            temporaryImageUrl;

                        previewLink.href =
                            temporaryImageUrl;

                        previewContainer.classList.remove(
                            "d-none"
                        );

                        noImageMessage.classList.add(
                            "d-none"
                        );

                        previewTitle.textContent =
                            selectedFile.name;
                    }
                );

                window.addEventListener(
                    "beforeunload",
                    function () {
                        if (temporaryImageUrl) {
                            URL.revokeObjectURL(
                                temporaryImageUrl
                            );
                        }
                    }
                );
            }
        );
    </script>

}