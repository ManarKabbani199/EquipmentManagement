@model IEnumerable<EquipmentManagement.Domain.Entities.Equipment>

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Equipment"];
}

<div class="d-flex justify-content-between
            align-items-center mb-4">

    <h1>@Localizer["Equipment"]</h1>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-primary">

            @Localizer["CreateNewEquipment"]

        </a>
    }

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        @Localizer["NoEquipment"]
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered
                      table-striped align-middle">

            <thead class="table-dark">

                <tr>
                    <th>@Localizer["Image"]</th>
                    <th>@Localizer["EquipmentName"]</th>
                    <th>@Localizer["SerialNumber"]</th>
                    <th>@Localizer["Description"]</th>
                    <th>@Localizer["PurchaseDate"]</th>
                    <th>@Localizer["PurchasePrice"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Category"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <a href="@item.ImagePath"
                                   target="_blank"
                                   rel="noopener noreferrer">

                                    <img src="@item.ImagePath"
                                         alt="@Localizer["EquipmentImageAlt", item.Name]"
                                         class="img-thumbnail"
                                         style="width:100px;
                                                height:80px;
                                                object-fit:cover;" />

                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    @Localizer["NoImage"]
                                </span>
                            }

                        </td>

                        <td>
                            @item.Name
                        </td>

                        <td>
                            @item.SerialNumber
                        </td>

                        <td>
                            @item.Description
                        </td>

                        <td>
                            @item.PurchaseDate.ToString("d")
                        </td>

                        <td>
                            @item.PurchasePrice.ToString("N2")
                        </td>

                        <td>

                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    @Localizer["Available"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @Localizer["Borrowed"]
                                </span>
                            }

                        </td>

                        <td>

                            @if (item.Category != null)
                            {
                                @item.Category.Name
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </td>

                        <td>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">

                                    @Localizer["Details"]

                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">

                                        @Localizer["Edit"]

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                        @Localizer["Delete"]

                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}