@model IEnumerable<EquipmentManagement.Domain.Entities.Equipment>

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Equipment"];

    var equipmentList = Model.ToList();
    var totalEquipment = equipmentList.Count;
    var availableEquipment = equipmentList.Count(e => e.IsAvailable);
    var borrowedEquipment = equipmentList.Count(e => !e.IsAvailable);
}

<style>
    .equipment-page {
        --equipment-primary: #2563eb;
        --equipment-success: #16a34a;
        --equipment-warning: #d97706;
        --equipment-danger: #dc2626;
        --equipment-info: #0891b2;
    }

    .equipment-header {
        position: relative;
        overflow: hidden;
        padding: 1.75rem;
        color: white;
        background:
            radial-gradient(circle at top right,
                rgba(255, 255, 255, 0.18),
                transparent 35%),
            linear-gradient(135deg, #0f172a, #1d4ed8);
        border-radius: 1.2rem;
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.12);
    }

    .equipment-header-content {
        position: relative;
        z-index: 1;
    }

    .equipment-header-title {
        margin-bottom: 0.4rem;
        font-size: clamp(1.55rem, 3vw, 2.1rem);
        font-weight: 800;
    }

    .equipment-header-description {
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.8);
    }

    .equipment-summary-card {
        height: 100%;
        padding: 1.25rem;
        background: white;
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1.5rem rgba(15, 23, 42, 0.07);
    }

    .equipment-summary-icon {
        display: inline-flex;
        width: 3rem;
        height: 3rem;
        flex: 0 0 3rem;
        align-items: center;
        justify-content: center;
        border-radius: 0.85rem;
    }

    .equipment-summary-icon svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    .equipment-summary-icon.total {
        color: #2563eb;
        background: #dbeafe;
    }

    .equipment-summary-icon.available {
        color: #15803d;
        background: #dcfce7;
    }

    .equipment-summary-icon.borrowed {
        color: #b45309;
        background: #fef3c7;
    }

    .equipment-summary-label {
        margin-bottom: 0.25rem;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .equipment-summary-value {
        margin-bottom: 0;
        color: #0f172a;
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1;
    }

    .equipment-section {
        overflow: hidden;
        background: white;
        border: 0;
        border-radius: 1.1rem;
        box-shadow: 0 0.5rem 1.5rem rgba(15, 23, 42, 0.07);
    }

    .equipment-table {
        min-width: 1050px;
    }

    .equipment-table thead th {
        padding: 1rem;
        color: #475569;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .equipment-table tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .equipment-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .equipment-table tbody tr:hover {
        background: #f8fafc;
    }

    .equipment-image {
        width: 4.5rem;
        height: 4.5rem;
        object-fit: cover;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.8rem;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .equipment-image:hover {
        transform: scale(1.05);
        box-shadow: 0 0.5rem 1rem rgba(15, 23, 42, 0.15);
    }

    .equipment-image-placeholder {
        display: inline-flex;
        width: 4.5rem;
        height: 4.5rem;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        background: #f1f5f9;
        border: 1px dashed #cbd5e1;
        border-radius: 0.8rem;
    }

    .equipment-image-placeholder svg {
        width: 1.75rem;
        height: 1.75rem;
    }

    .equipment-name {
        color: #0f172a;
        font-weight: 700;
    }

    .equipment-serial {
        direction: ltr;
        display: inline-block;
        color: #475569;
        font-family: monospace;
        font-size: 0.85rem;
        background: #f1f5f9;
        padding: 0.3rem 0.5rem;
        border-radius: 0.4rem;
    }

    .equipment-description {
        display: block;
        max-width: 15rem;
        overflow: hidden;
        color: #64748b;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .equipment-status {
        display: inline-flex;
        gap: 0.4rem;
        align-items: center;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .equipment-status::before {
        content: "";
        width: 0.45rem;
        height: 0.45rem;
        background: currentColor;
        border-radius: 50%;
    }

    .equipment-status.available {
        color: #15803d;
        background: #dcfce7;
    }

    .equipment-status.borrowed {
        color: #b45309;
        background: #fef3c7;
    }

    .equipment-category {
        display: inline-flex;
        padding: 0.4rem 0.65rem;
        color: #4338ca;
        background: #e0e7ff;
        border-radius: 0.55rem;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .equipment-actions {
        display: flex;
        gap: 0.4rem;
        flex-wrap: nowrap;
    }

    .equipment-action-button {
        display: inline-flex;
        width: 2.3rem;
        height: 2.3rem;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 0.55rem;
    }

    .equipment-action-button svg {
        width: 1rem;
        height: 1rem;
    }

    .equipment-empty-state {
        padding: 4rem 1rem;
        color: #64748b;
        text-align: center;
    }

    .equipment-empty-icon {
        display: inline-flex;
        width: 4.5rem;
        height: 4.5rem;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: #2563eb;
        background: #dbeafe;
        border-radius: 50%;
    }

    .equipment-empty-icon svg {
        width: 2.2rem;
        height: 2.2rem;
    }

    @@media (max-width: 767.98px) {
        .equipment-header {
            padding: 1.35rem;
            border-radius: 1rem;
        }

        .equipment-header-content {
            align-items: stretch !important;
            flex-direction: column;
        }

        .equipment-header .btn {
            width: 100%;
        }

        /* تحويل بطاقات الإحصائيات إلى عمود واحد */
        .equipment-page .row>.col-sm-4 {
            width: 100%;
        }

        /* إلغاء العرض الأفقي للجدول */
        .equipment-section {
            overflow: visible;
            background: transparent;
            box-shadow: none;
        }

        .equipment-section .table-responsive {
            overflow: visible;
        }

        .equipment-table {
            min-width: 0;
            background: transparent;
        }

        .equipment-table thead {
            display: none;
        }

        .equipment-table,
        .equipment-table tbody,
        .equipment-table tr,
        .equipment-table td {
            display: block;
            width: 100%;
        }

        .equipment-table tbody {
            padding: 0;
        }

        /* كل صف يصبح بطاقة */
        .equipment-table tbody tr {
            overflow: hidden;
            margin-bottom: 1rem;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 0.4rem 1rem rgba(15, 23, 42, 0.08);
        }

        .equipment-table tbody tr:hover {
            background: white;
        }

        .equipment-table tbody tr:last-child {
            margin-bottom: 0;
        }

        /* كل خلية تصبح سطرًا داخل البطاقة */
        .equipment-table tbody td {
            display: flex;
            gap: 1rem;
            min-height: 3.3rem;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1rem;
            text-align: end;
            border: 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .equipment-table tbody td:last-child {
            border-bottom: 0;
        }

        /* إظهار اسم الحقل */
        .equipment-table tbody td::before {
            content: attr(data-label);
            flex: 0 0 40%;
            color: #64748b;
            font-size: 0.82rem;
            font-weight: 700;
            text-align: start;
        }

        /* الصورة أعلى البطاقة */
        .equipment-table tbody td.equipment-image-cell {
            justify-content: center;
            padding: 1.25rem;
            background: #f8fafc;
        }

        .equipment-table tbody td.equipment-image-cell::before {
            display: none;
        }

        .equipment-image,
        .equipment-image-placeholder {
            width: 8rem;
            height: 8rem;
        }

        .equipment-description {
            max-width: 55%;
            overflow: visible;
            text-align: end;
            text-overflow: initial;
            white-space: normal;
        }

        .equipment-serial {
            max-width: 55%;
            overflow-wrap: anywhere;
        }

        .equipment-actions {
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .equipment-action-button {
            width: 2.5rem;
            height: 2.5rem;
        }
    }

    @@media (max-width: 380px) {
        .equipment-table tbody td {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.45rem;
            text-align: start;
        }

        .equipment-table tbody td::before {
            flex: none;
            width: 100%;
        }

        .equipment-description,
        .equipment-serial {
            max-width: 100%;
            text-align: start;
        }

        .equipment-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .equipment-table tbody td.equipment-image-cell {
            align-items: center;
        }
    }
</style>

<div class="equipment-page">

    <!-- عنوان الصفحة -->
    <section class="equipment-header mb-4">

        <div class="equipment-header-content
            d-flex justify-content-between
            align-items-center gap-3">

            <div>

                <h1 class="equipment-header-title">
                    @Localizer["Equipment"]
                </h1>

                <p class="equipment-header-description">
                    @Localizer["DashboardSummary"]
                </p>

            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light fw-semibold px-4">

                    <span class="me-1">+</span>
                    @Localizer["CreateNewEquipment"]

                </a>
            }

        </div>

    </section>

    <!-- رسائل النجاح والخطأ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success
            alert-dismissible fade show shadow-sm" role="alert">

            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Cancel"]">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible fade show shadow-sm" role="alert">

            @TempData["ErrorMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Cancel"]">
            </button>

        </div>
    }

    <!-- ملخص أعداد المعدات -->
    <div class="row g-3 mb-4">

        <div class="col-sm-4">

            <div class="equipment-summary-card">

                <div class="d-flex align-items-center gap-3">

                    <span class="equipment-summary-icon total">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                            <path
                            d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                            <path d="m3.3 7 8.7 5 8.7-5" />
                            <path d="M12 22V12" />

                        </svg>

                    </span>

                    <div>
                        <p class="equipment-summary-label">
                            @Localizer["TotalEquipment"]
                        </p>

                        <p class="equipment-summary-value">
                            @totalEquipment
                        </p>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-sm-4">

            <div class="equipment-summary-card">

                <div class="d-flex align-items-center gap-3">

                    <span class="equipment-summary-icon available">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                            <path d="M20 6 9 17l-5-5" />

                        </svg>

                    </span>

                    <div>
                        <p class="equipment-summary-label">
                            @Localizer["AvailableEquipment"]
                        </p>

                        <p class="equipment-summary-value">
                            @availableEquipment
                        </p>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-sm-4">

            <div class="equipment-summary-card">

                <div class="d-flex align-items-center gap-3">

                    <span class="equipment-summary-icon borrowed">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                            <path d="M7 7h11l-3-3" />
                            <path d="m18 7-3 3" />
                            <path d="M17 17H6l3 3" />
                            <path d="m6 17 3-3" />

                        </svg>

                    </span>

                    <div>
                        <p class="equipment-summary-label">
                            @Localizer["BorrowedEquipment"]
                        </p>

                        <p class="equipment-summary-value">
                            @borrowedEquipment
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- جدول المعدات -->
    <section class="equipment-section">

        @if (totalEquipment == 0)
        {
            <div class="equipment-empty-state">

                <span class="equipment-empty-icon">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <path
                        d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />

                    </svg>

                </span>

                <p class="fw-semibold mb-3">
                    @Localizer["NoEquipment"]
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-primary">

                        @Localizer["CreateNewEquipment"]

                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table equipment-table mb-0">

                    <tbody>

                        @foreach (var item in equipmentList)
                        {
                            <tr>

                                <!-- الصورة -->
                                <td class="equipment-image-cell" data-label="@Localizer["Image"]">

                                    @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                    {
                                        <a href="@item.ImagePath" target="_blank" rel="noopener noreferrer">

                                            <img src="@item.ImagePath" alt="@Localizer["EquipmentImageAlt", item.Name]"
                                                 class="equipment-image" />

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="equipment-image-placeholder" title="@Localizer["NoImage"]">

                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                                <rect x="3" y="3" width="18" height="18" rx="2" />

                                                <circle cx="8.5" cy="8.5" r="1.5" />

                                                <path d="m21 15-5-5L5 21" />

                                            </svg>

                                        </span>
                                    }

                                </td>

                                <!-- اسم المعدة -->
                                <td data-label="@Localizer["EquipmentName"]">

                                    <span class="equipment-name">
                                        @item.Name
                                    </span>

                                </td>

                                <!-- الرقم التسلسلي -->
                                <td data-label="@Localizer["SerialNumber"]">

                                    <span class="equipment-serial">
                                        @item.SerialNumber
                                    </span>

                                </td>

                                <!-- الوصف -->
                                <td data-label="@Localizer["Description"]">

                                    <span class="equipment-description" title="@item.Description">

                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "-"
                                            : item.Description)

                                    </span>

                                </td>

                                <!-- تاريخ الشراء -->
                                <td data-label="@Localizer["PurchaseDate"]">

                                    @item.PurchaseDate.ToString("d")

                                </td>

                                <!-- سعر الشراء -->
                                <td data-label="@Localizer["PurchasePrice"]" class="fw-semibold">

                                    @item.PurchasePrice.ToString("N2")

                                </td>

                                <!-- الحالة -->
                                <td data-label="@Localizer["Status"]">

                                    @if (item.IsAvailable)
                                    {
                                        <span class="equipment-status available">
                                            @Localizer["Available"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="equipment-status borrowed">
                                            @Localizer["Borrowed"]
                                        </span>
                                    }

                                </td>

                                <!-- التصنيف -->
                                <td data-label="@Localizer["Category"]">

                                    @if (item.Category != null)
                                    {
                                        <span class="equipment-category">
                                            @item.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- الإجراءات -->
                                <td data-label="@Localizer["Actions"]">

                                    <div class="equipment-actions">

                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info
                                            equipment-action-button" title="@Localizer["Details"]" aria-label="@Localizer["Details"]">

                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                                <circle cx="12" cy="12" r="3" />

                                            </svg>

                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning
                                                equipment-action-button" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]">

                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                                    <path d="M12 20h9" />
                                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />

                                                </svg>

                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger
                                                equipment-action-button" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]">

                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                                    <path d="M3 6h18" />
                                                    <path d="M8 6V4h8v2" />
                                                    <path d="M19 6l-1 14H6L5 6" />
                                                    <path d="M10 11v5" />
                                                    <path d="M14 11v5" />

                                                </svg>

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>