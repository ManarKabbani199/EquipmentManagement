@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["DeleteEquipment"];

    var deleteConfirmation =
        Localizer["DeleteConfirmation"].Value;
}

<div class="row justify-content-center">

    <div class="col-md-9 col-lg-7">

        <div class="card border-danger shadow-sm">

            <div class="card-header bg-danger text-white">

                <h1 class="h4 mb-0">
                    @Localizer["DeleteEquipment"]
                </h1>

            </div>

            <div class="card-body">

                <div class="alert alert-warning">

                    <strong>
                        @Localizer["DeleteConfirmation"]
                    </strong>

                    <div class="mt-2">
                        @Localizer["DeleteEquipmentWarning"]
                    </div>

                </div>

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="text-center mb-4">

                        <img src="@Model.ImagePath"
                             alt="@Localizer["EquipmentImageAlt", Model.Name]"
                             class="img-thumbnail"
                             style="width:220px;
                                    height:170px;
                                    object-fit:contain;" />

                    </div>
                }

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        @Localizer["EquipmentName"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["SerialNumber"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.SerialNumber
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Description"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["PurchaseDate"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.PurchaseDate.ToString("d")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["PurchasePrice"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.PurchasePrice.ToString("N2")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Status"]
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success">
                                @Localizer["Available"]
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @Localizer["Borrowed"]
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Category"]
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Category?.Name ?? "-")
                    </dd>

                </dl>

            </div>

            <div class="card-footer">

                <form asp-action="Delete"
                      method="post"
                      onsubmit="return confirm('@deleteConfirmation');">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">

                            @Localizer["ConfirmDelete"]

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            @Localizer["Cancel"]

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>