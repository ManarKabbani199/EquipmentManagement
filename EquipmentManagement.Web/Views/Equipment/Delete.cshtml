@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["DeleteEquipment"];
}

<div class="equipment-record-page
            equipment-theme-delete">

    <section class="equipment-record-header mb-4">

        <div class="equipment-record-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="equipment-record-title mb-1">
                    @Localizer["DeleteEquipment"]
                </h1>

                <p class="equipment-record-subtitle mb-0">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <div class="equipment-delete-warning mb-4">

        <span class="equipment-delete-warning-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 aria-hidden="true">

                <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />

            </svg>

        </span>

        <div>

            <strong class="d-block mb-1">
                @Localizer["DeleteConfirmation"]
            </strong>

            <span>
                @Localizer["DeleteEquipmentWarning"]
            </span>

        </div>

    </div>

    <section class="equipment-record-card">

        <div class="row g-0">

            <div class="col-lg-6">

                <div class="equipment-record-image-area">

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ImagePath))
                    {
                        <a href="@Model.ImagePath"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@Model.ImagePath"
                                 alt="@Localizer[
                                     "EquipmentImageAlt",
                                     Model.Name
                                 ]"
                                 class="equipment-record-image" />

                        </a>
                    }
                    else
                    {
                        <div class="equipment-record-placeholder">

                            <span class="equipment-record-placeholder-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     aria-hidden="true">

                                    <rect x="3"
                                          y="3"
                                          width="18"
                                          height="18"
                                          rx="2" />

                                    <circle cx="8.5"
                                            cy="8.5"
                                            r="1.5" />

                                    <path d="m21 15-5-5L5 21" />

                                </svg>

                            </span>

                            <p class="text-muted mt-2 mb-0">
                                @Localizer["NoImageForEquipment"]
                            </p>

                        </div>
                    }

                </div>

            </div>

            <div class="col-lg-6">

                <div class="equipment-record-information">

                    <h2 class="equipment-record-name">
                        @Model.Name
                    </h2>

                    <dl class="equipment-record-list">

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["SerialNumber"]
                            </dt>

                            <dd class="equipment-record-value">

                                <span class="equipment-record-serial">
                                    @Model.SerialNumber
                                </span>

                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["Description"]
                            </dt>

                            <dd class="equipment-record-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Description)
                                    ? "-"
                                    : Model.Description)

                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["PurchaseDate"]
                            </dt>

                            <dd class="equipment-record-value">
                                @Model.PurchaseDate.ToString("d")
                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["PurchasePrice"]
                            </dt>

                            <dd class="equipment-record-value fw-bold">
                                @Model.PurchasePrice.ToString("N2")
                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["Status"]
                            </dt>

                            <dd class="equipment-record-value">

                                @if (Model.IsAvailable)
                                {
                                    <span class="equipment-record-status available">
                                        @Localizer["Available"]
                                    </span>
                                }
                                else
                                {
                                    <span class="equipment-record-status borrowed">
                                        @Localizer["Borrowed"]
                                    </span>
                                }

                            </dd>

                        </div>

                        <div class="equipment-record-row">

                            <dt class="equipment-record-label">
                                @Localizer["Category"]
                            </dt>

                            <dd class="equipment-record-value">

                                @if (Model.Category != null)
                                {
                                    <span class="equipment-record-category">
                                        @Model.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <div class="equipment-record-footer">

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-danger px-4"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteEquipmentModal">

                    @Localizer["ConfirmDelete"]

                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["Cancel"]

                </a>

            </div>

        </div>

    </section>

</div>

<!-- نافذة تأكيد حذف المعدة -->
<div class="modal fade"
     id="deleteEquipmentModal"
     tabindex="-1"
     aria-labelledby="deleteEquipmentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <form asp-action="Delete"
              method="post"
              class="modal-content equipment-delete-modal">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div class="modal-header equipment-delete-modal-header">

                <h2 class="modal-title h5 mb-0"
                    id="deleteEquipmentModalLabel">

                    @Localizer["DeleteEquipment"]

                </h2>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Cancel"]">
                </button>

            </div>

            <div class="modal-body p-4 text-center">

                <span class="equipment-delete-modal-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />

                    </svg>

                </span>

                <h3 class="h5 fw-bold mb-3">
                    @Localizer["DeleteConfirmation"]
                </h3>

                <p class="text-muted mb-3">
                    @Localizer["DeleteEquipmentWarning"]
                </p>

                <div class="equipment-delete-modal-name">
                    @Model.Name
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary px-4"
                        data-bs-dismiss="modal">

                    @Localizer["Cancel"]

                </button>

                <button type="submit"
                        class="btn btn-danger px-4">

                    @Localizer["ConfirmDelete"]

                </button>

            </div>

        </form>

    </div>

</div>