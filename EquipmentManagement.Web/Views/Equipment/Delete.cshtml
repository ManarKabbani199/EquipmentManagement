@model EquipmentManagement.Domain.Entities.Equipment

@using Microsoft.Extensions.Localization
@using System.Text.Json

@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["DeleteEquipment"];

    var deleteConfirmationJson =
        JsonSerializer.Serialize(
            Localizer["DeleteConfirmation"].Value
        );
}

<style>
    .delete-equipment-header {
        position: relative;
        overflow: hidden;
        padding: 1.75rem;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(255, 255, 255, 0.18),
                transparent 35%
            ),
            linear-gradient(135deg, #450a0a, #dc2626);
        border-radius: 1.2rem;
        box-shadow: 0 1rem 2rem rgba(127, 29, 29, 0.16);
    }

    .delete-equipment-header-content {
        position: relative;
        z-index: 1;
    }

    .delete-equipment-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
    }

    .delete-equipment-card {
        overflow: hidden;
        background: white;
        border: 1px solid #fecaca;
        border-radius: 1.1rem;
        box-shadow: 0 0.6rem 1.8rem rgba(127, 29, 29, 0.09);
    }

    .delete-warning {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        padding: 1.25rem;
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 0.9rem;
    }

    .delete-warning-icon {
        display: inline-flex;
        width: 3rem;
        height: 3rem;
        flex: 0 0 3rem;
        align-items: center;
        justify-content: center;
        color: #dc2626;
        background: #fee2e2;
        border-radius: 50%;
    }

    .delete-warning-icon svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    .delete-equipment-image-area {
        display: flex;
        min-height: 20rem;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: #f8fafc;
        border-inline-end: 1px solid #e2e8f0;
    }

    .delete-equipment-image {
        width: 100%;
        max-width: 25rem;
        max-height: 20rem;
        object-fit: contain;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 0.9rem;
    }

    .delete-image-placeholder {
        display: inline-flex;
        width: 5rem;
        height: 5rem;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        background: #e2e8f0;
        border-radius: 50%;
    }

    .delete-image-placeholder svg {
        width: 2.5rem;
        height: 2.5rem;
    }

    .delete-equipment-information {
        padding: 1.5rem;
    }

    .delete-equipment-name {
        color: #0f172a;
        font-size: 1.5rem;
        font-weight: 800;
    }

    .delete-details-list {
        margin: 1rem 0 0;
    }

    .delete-details-row {
        display: grid;
        grid-template-columns: minmax(8rem, 0.8fr) 1.5fr;
        gap: 1rem;
        padding: 0.9rem 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .delete-details-row:last-child {
        border-bottom: 0;
    }

    .delete-details-label {
        margin: 0;
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .delete-details-value {
        margin: 0;
        color: #0f172a;
        overflow-wrap: anywhere;
    }

    .delete-serial {
        direction: ltr;
        display: inline-block;
        padding: 0.3rem 0.55rem;
        background: #f1f5f9;
        border-radius: 0.4rem;
        font-family: monospace;
    }

    .delete-status {
        display: inline-flex;
        gap: 0.4rem;
        align-items: center;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .delete-status::before {
        content: "";
        width: 0.45rem;
        height: 0.45rem;
        background: currentColor;
        border-radius: 50%;
    }

    .delete-status.available {
        color: #15803d;
        background: #dcfce7;
    }

    .delete-status.borrowed {
        color: #b45309;
        background: #fef3c7;
    }

    .delete-category {
        display: inline-flex;
        padding: 0.4rem 0.7rem;
        color: #4338ca;
        background: #e0e7ff;
        border-radius: 0.55rem;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .delete-equipment-footer {
        padding: 1.25rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 991.98px) {
        .delete-equipment-image-area {
            min-height: 16rem;
            border-inline-end: 0;
            border-bottom: 1px solid #e2e8f0;
        }
    }

    @@media (max-width: 575.98px) {
        .delete-equipment-header {
            padding: 1.3rem;
            border-radius: 1rem;
        }

        .delete-equipment-header-content {
            align-items: stretch !important;
            flex-direction: column;
        }

        .delete-equipment-header .btn {
            width: 100%;
        }

        .delete-warning {
            flex-direction: column;
        }

        .delete-details-row {
            grid-template-columns: 1fr;
            gap: 0.35rem;
        }

        .delete-equipment-footer .d-flex {
            flex-direction: column;
        }

        .delete-equipment-footer .btn {
            width: 100%;
        }
    }
</style>

<div class="delete-equipment-page">

    <!-- عنوان الصفحة -->
    <section class="delete-equipment-header mb-4">

        <div class="delete-equipment-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="delete-equipment-title mb-1">
                    @Localizer["DeleteEquipment"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]
            </a>

        </div>

    </section>

    <!-- رسالة التحذير -->
    <div class="delete-warning mb-4">

        <span class="delete-warning-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />

            </svg>

        </span>

        <div>

            <strong class="d-block mb-1">
                @Localizer["DeleteConfirmation"]
            </strong>

            <span>
                @Localizer["DeleteEquipmentWarning"]
            </span>

        </div>

    </div>

    <!-- معلومات المعدة -->
    <section class="delete-equipment-card">

        <div class="row g-0">

            <!-- صورة المعدة -->
            <div class="col-lg-6">

                <div class="delete-equipment-image-area">

                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <a href="@Model.ImagePath"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@Model.ImagePath"
                                 alt="@Localizer["EquipmentImageAlt", Model.Name]"
                                 class="delete-equipment-image" />

                        </a>
                    }
                    else
                    {
                        <div class="text-center">

                            <span class="delete-image-placeholder">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect x="3"
                                          y="3"
                                          width="18"
                                          height="18"
                                          rx="2" />

                                    <circle cx="8.5"
                                            cy="8.5"
                                            r="1.5" />

                                    <path d="m21 15-5-5L5 21" />

                                </svg>

                            </span>

                            <p class="text-muted mt-3 mb-0">
                                @Localizer["NoImageForEquipment"]
                            </p>

                        </div>
                    }

                </div>

            </div>

            <!-- التفاصيل -->
            <div class="col-lg-6">

                <div class="delete-equipment-information">

                    <h2 class="delete-equipment-name">
                        @Model.Name
                    </h2>

                    <dl class="delete-details-list">

                        <div class="delete-details-row">

                            <dt class="delete-details-label">
                                @Localizer["SerialNumber"]
                            </dt>

                            <dd class="delete-details-value">

                                <span class="delete-serial">
                                    @Model.SerialNumber
                                </span>

                            </dd>

                        </div>

                        <div class="delete-details-row">

                            <dt class="delete-details-label">
                                @Localizer["Description"]
                            </dt>

                            <dd class="delete-details-value">

                                @(string.IsNullOrWhiteSpace(Model.Description)
                                    ? "-"
                                    : Model.Description)

                            </dd>

                        </div>

                        <div class="delete-details-row">

                            <dt class="delete-details-label">
                                @Localizer["PurchaseDate"]
                            </dt>

                            <dd class="delete-details-value">
                                @Model.PurchaseDate.ToString("d")
                            </dd>

                        </div>

                        <div class="delete-details-row">

                            <dt class="delete-details-label">
                                @Localizer["PurchasePrice"]
                            </dt>

                            <dd class="delete-details-value fw-bold">
                                @Model.PurchasePrice.ToString("N2")
                            </dd>

                        </div>

                        <div class="delete-details-row">

                            <dt class="delete-details-label">
                                @Localizer["Status"]
                            </dt>

                            <dd class="delete-details-value">

                                @if (Model.IsAvailable)
                                {
                                    <span class="delete-status available">
                                        @Localizer["Available"]
                                    </span>
                                }
                                else
                                {
                                    <span class="delete-status borrowed">
                                        @Localizer["Borrowed"]
                                    </span>
                                }

                            </dd>

                        </div>

                        <div class="delete-details-row">

                            <dt class="delete-details-label">
                                @Localizer["Category"]
                            </dt>

                            <dd class="delete-details-value">

                                @if (Model.Category != null)
                                {
                                    <span class="delete-category">
                                        @Model.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <!-- نموذج الحذف -->
        <div class="delete-equipment-footer">

            <form id="deleteEquipmentForm"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger px-4">

                        @Localizer["ConfirmDelete"]
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-info px-4">

                        @Localizer["Details"]
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        @Localizer["Cancel"]
                    </a>

                </div>

            </form>

        </div>

    </section>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const deleteForm =
                document.getElementById("deleteEquipmentForm");

            const confirmationMessage =
                @Html.Raw(deleteConfirmationJson);

            deleteForm.addEventListener("submit", function (event) {

                if (!window.confirm(confirmationMessage)) {
                    event.preventDefault();
                }

            });

        });
    </script>

}