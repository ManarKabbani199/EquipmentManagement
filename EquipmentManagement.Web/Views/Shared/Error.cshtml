@model ErrorViewModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Error"];
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card border-danger shadow-sm text-center">

            <div class="card-header bg-danger text-white">

                <h1 class="h4 mb-0">
                    @Localizer["Error"]
                </h1>

            </div>

            <div class="card-body py-5">

                <div class="mb-4"
                     style="font-size:4rem; line-height:1;">

                    ⚠️

                </div>

                <h2 class="h5 text-danger mb-3">
                    @Localizer["UnexpectedError"]
                </h2>

                <p class="text-muted">
                    @Localizer["UnexpectedErrorMessage"]
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border">

                        <strong>
                            @Localizer["RequestId"]:
                        </strong>

                        <code>@Model.RequestId</code>

                    </div>
                }

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary mt-2">

                    @Localizer["ReturnHome"]

                </a>

            </div>

        </div>

    </div>

</div>