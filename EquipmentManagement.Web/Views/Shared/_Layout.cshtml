@using System.Globalization
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<SharedResource> Localizer

@{
    var culture =
        CultureInfo.CurrentUICulture
            .TwoLetterISOLanguageName;

    var isArabic = culture == "ar";

    var direction =
        isArabic ? "rtl" : "ltr";

    var returnUrl =
        Context.Request.Path +
        Context.Request.QueryString;

    var currentController =
        ViewContext.RouteData
            .Values["controller"]?
            .ToString();

    string ActiveLink(string controller)
    {
        return string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase
        )
            ? "active"
            : string.Empty;
    }
}

<!DOCTYPE html>

<html lang="@culture" dir="@direction">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - @Localizer["ApplicationName"]
    </title>

    <script type="importmap"></script>

    @if (isArabic)
    {
        <link rel="stylesheet"
              href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet"
              href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/EquipmentManagement.Web.styles.css"
          asp-append-version="true" />

</head>

<body class="app-body">

<header>

    <nav class="navbar navbar-expand-xl navbar-dark
                app-navbar sticky-top">

        <div class="container">

            <a class="navbar-brand app-brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="brand-icon">
                    EM
                </span>

                <span class="brand-text">
                    @Localizer["ApplicationName"]
                </span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="@Localizer["ToggleNavigation"]">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div id="mainNavbar"
                 class="collapse navbar-collapse">

                <ul class="navbar-nav app-navigation">

                    <li class="nav-item">

                        <a class="nav-link @ActiveLink("Home")"
                           asp-controller="Home"
                           asp-action="Index">

                            @Localizer["Home"]

                        </a>

                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">

                            <a class="nav-link @ActiveLink("Dashboard")"
                               asp-controller="Dashboard"
                               asp-action="Index">

                                @Localizer["Dashboard"]

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @ActiveLink("Categories")"
                               asp-controller="Categories"
                               asp-action="Index">

                                @Localizer["Categories"]

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @ActiveLink("Equipment")"
                               asp-controller="Equipment"
                               asp-action="Index">

                                @Localizer["Equipment"]

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @ActiveLink("Employees")"
                               asp-controller="Employees"
                               asp-action="Index">

                                @Localizer["Employees"]

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @ActiveLink("BorrowingRecords")"
                               asp-controller="BorrowingRecords"
                               asp-action="Index">

                                @Localizer["ManageBorrowings"]

                            </a>

                        </li>
                    }

                    @if (User.IsInRole("Employee"))
                    {
                        <li class="nav-item">

                            <a class="nav-link @ActiveLink("BorrowingRecords")"
                               asp-controller="BorrowingRecords"
                               asp-action="Index">

                                @Localizer["MyBorrowings"]

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="BorrowingRecords"
                               asp-action="Create">

                                @Localizer["BorrowEquipment"]

                            </a>

                        </li>
                    }

                </ul>

                <div class="navbar-actions">

                    <div class="language-switcher">

                        <a class="language-link
                                  @(isArabic ? "active" : "")"
                           asp-controller="Localization"
                           asp-action="SetLanguage"
                           asp-route-culture="ar"
                           asp-route-returnUrl="@returnUrl">

                            العربية

                        </a>

                        <a class="language-link
                                  @(!isArabic ? "active" : "")"
                           asp-controller="Localization"
                           asp-action="SetLanguage"
                           asp-route-culture="en"
                           asp-route-returnUrl="@returnUrl">

                            English

                        </a>

                    </div>

                    <div class="account-navigation">
                        <partial name="_LoginPartial" />
                    </div>

                </div>

            </div>

        </div>

    </nav>

</header>

<div class="app-page">

    <main role="main"
          class="container app-main">

        @RenderBody()

    </main>

</div>

<footer class="app-footer">

    <div class="container">

        <div class="footer-content">

            <span>
                &copy; 2026 @Localizer["ApplicationName"]
            </span>

            <a asp-controller="Home"
               asp-action="Privacy">

                @Localizer["Privacy"]

            </a>

        </div>

    </div>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

</html>