@model EquipmentManagement.Web.Models.DashboardViewModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Dashboard"];

    var overdueCount = Model.OverdueBorrowings;
    var hasOverdueBorrowings = overdueCount > 0;
}

<div class="dashboard-page">

    <!-- عنوان لوحة التحكم -->
    <section class="dashboard-hero mb-4">

        <div class="dashboard-hero-content">

            <div class="d-flex flex-column flex-lg-row
                        justify-content-between
                        align-items-lg-center gap-3">

                <div>

                    <h1 class="dashboard-title mb-2">
                        @Localizer["Dashboard"]
                    </h1>

                    <p class="dashboard-subtitle mb-0">
                        @Localizer["DashboardSummary"]
                    </p>

                </div>

                <a asp-controller="BorrowingRecords"
                   asp-action="Index"
                   class="btn btn-light fw-semibold px-4">

                    @Localizer["ViewAllBorrowings"]
                </a>

            </div>

        </div>

    </section>

    <!-- البطاقات الإحصائية -->
    <div class="row g-4">

        <!-- إجمالي المعدات -->
        <div class="col-sm-6 col-xl-4">

            <div class="dashboard-stat-card primary">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <p class="stat-label">
                                @Localizer["TotalEquipment"]
                            </p>

                            <p class="stat-value">
                                @Model.TotalEquipment
                            </p>

                        </div>

                        <span class="stat-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                                <path d="m3.3 7 8.7 5 8.7-5" />
                                <path d="M12 22V12" />

                            </svg>

                        </span>

                    </div>

                </div>

                <div class="card-footer
                            bg-transparent border-0 px-4 pb-4">

                    <a asp-controller="Equipment"
                       asp-action="Index"
                       class="stat-link">

                        @Localizer["ViewEquipment"] ←
                    </a>

                </div>

            </div>

        </div>

        <!-- المعدات المتاحة -->
        <div class="col-sm-6 col-xl-4">

            <div class="dashboard-stat-card success">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <p class="stat-label">
                                @Localizer["AvailableEquipment"]
                            </p>

                            <p class="stat-value">
                                @Model.AvailableEquipment
                            </p>

                        </div>

                        <span class="stat-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- المعدات المستعارة -->
        <div class="col-sm-6 col-xl-4">

            <div class="dashboard-stat-card warning">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <p class="stat-label">
                                @Localizer["BorrowedEquipment"]
                            </p>

                            <p class="stat-value">
                                @Model.BorrowedEquipment
                            </p>

                        </div>

                        <span class="stat-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M7 7h11l-3-3" />
                                <path d="m18 7-3 3" />
                                <path d="M17 17H6l3 3" />
                                <path d="m6 17 3-3" />

                            </svg>

                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- الموظفون -->
        <div class="col-sm-6 col-xl-4">

            <div class="dashboard-stat-card info">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <p class="stat-label">
                                @Localizer["TotalEmployees"]
                            </p>

                            <p class="stat-value">
                                @Model.TotalEmployees
                            </p>

                        </div>

                        <span class="stat-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9"
                                        cy="7"
                                        r="4" />
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />

                            </svg>

                        </span>

                    </div>

                </div>

                <div class="card-footer
                            bg-transparent border-0 px-4 pb-4">

                    <a asp-controller="Employees"
                       asp-action="Index"
                       class="stat-link">

                        @Localizer["ViewEmployees"] ←
                    </a>

                </div>

            </div>

        </div>

        <!-- الاستعارات النشطة -->
        <div class="col-sm-6 col-xl-4">

            <div class="dashboard-stat-card secondary">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <p class="stat-label">
                                @Localizer["ActiveBorrowings"]
                            </p>

                            <p class="stat-value">
                                @Model.ActiveBorrowings
                            </p>

                        </div>

                        <span class="stat-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />
                                <path d="M12 7v5l3 2" />

                            </svg>

                        </span>

                    </div>

                </div>

                <div class="card-footer
                            bg-transparent border-0 px-4 pb-4">

                    <a asp-controller="BorrowingRecords"
                       asp-action="Index"
                       class="stat-link">

                        @Localizer["ViewBorrowings"] ←
                    </a>

                </div>

            </div>

        </div>

        <!-- الاستعارات المتأخرة -->
        <div class="col-sm-6 col-xl-4">

            <div class="dashboard-stat-card danger">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <p class="stat-label">
                                @Localizer["OverdueBorrowings"]
                            </p>

                            <p class="stat-value">
                                @Model.OverdueBorrowings
                            </p>

                        </div>

                        <span class="stat-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                                <path d="M12 9v4" />
                                <path d="M12 17h.01" />

                            </svg>

                        </span>

                    </div>

                </div>

                <div class="card-footer
                            bg-transparent border-0 px-4 pb-4">

                    @if (hasOverdueBorrowings)
                    {
                        <span class="status-badge overdue">
                            @Localizer["OverdueEquipmentWarning"]
                        </span>
                    }
                    else
                    {
                        <span class="status-badge on-time">
                            @Localizer["NoOverdueBorrowings"]
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- الإجراءات السريعة للمدير -->
    @if (User.IsInRole("Admin"))
    {
        <section class="dashboard-section mt-5">

            <div class="dashboard-section-header">

                <h2 class="h5 fw-bold mb-0">
                    @Localizer["QuickActions"]
                </h2>

            </div>

            <div class="card-body p-4">

                <div class="row g-3">

                    <!-- إضافة معدة -->
                    <div class="col-sm-6 col-xl-3">

                        <a asp-controller="Equipment"
                           asp-action="Create"
                           class="quick-action-link">

                            <span class="quick-action-icon equipment-action">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                                    <path d="M12 8v8" />
                                    <path d="M8 12h8" />

                                </svg>

                            </span>

                            <span class="fw-semibold">
                                @Localizer["CreateNewEquipment"]
                            </span>

                        </a>

                    </div>

                    <!-- إضافة موظف -->
                    <div class="col-sm-6 col-xl-3">

                        <a asp-controller="Employees"
                           asp-action="Create"
                           class="quick-action-link">

                            <span class="quick-action-icon employee-action">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <circle cx="9"
                                            cy="7"
                                            r="4" />
                                    <path d="M3 21v-2a6 6 0 0 1 12 0v2" />
                                    <path d="M19 8v6" />
                                    <path d="M16 11h6" />

                                </svg>

                            </span>

                            <span class="fw-semibold">
                                @Localizer["CreateNewEmployee"]
                            </span>

                        </a>

                    </div>

                    <!-- تسجيل استعارة -->
                    <div class="col-sm-6 col-xl-3">

                        <a asp-controller="BorrowingRecords"
                           asp-action="Create"
                           class="quick-action-link">

                            <span class="quick-action-icon borrowing-action">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M7 7h11l-3-3" />
                                    <path d="m18 7-3 3" />
                                    <path d="M17 17H6l3 3" />
                                    <path d="m6 17 3-3" />

                                </svg>

                            </span>

                            <span class="fw-semibold">
                                @Localizer["BorrowEquipment"]
                            </span>

                        </a>

                    </div>

                    <!-- إضافة تصنيف -->
                    <div class="col-sm-6 col-xl-3">

                        <a asp-controller="Categories"
                           asp-action="Create"
                           class="quick-action-link">

                            <span class="quick-action-icon category-action">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M4 4h6v6H4z" />
                                    <path d="M14 4h6v6h-6z" />
                                    <path d="M4 14h6v6H4z" />
                                    <path d="M14 14h6v6h-6z" />

                                </svg>

                            </span>

                            <span class="fw-semibold">
                                @Localizer["CreateNewCategory"]
                            </span>

                        </a>

                    </div>

                </div>

            </div>

        </section>
    }

    <!-- أحدث الاستعارات -->
    <section class="dashboard-section mt-5">

        <div class="dashboard-section-header
                    d-flex justify-content-between
                    align-items-center">

            <div>

                <h2 class="h5 fw-bold mb-1">
                    @Localizer["RecentActiveBorrowings"]
                </h2>

                <small class="text-muted">
                    @Localizer["DashboardSummary"]
                </small>

            </div>

            <a asp-controller="BorrowingRecords"
               asp-action="Index"
               class="btn btn-primary btn-sm px-3">

                @Localizer["ViewAllBorrowings"]
            </a>

        </div>

        @if (!Model.RecentBorrowings.Any())
        {
            <div class="empty-dashboard-state">

                <span class="empty-dashboard-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M20 6 9 17l-5-5" />

                    </svg>

                </span>

                <p class="fw-semibold mb-0">
                    @Localizer["NoActiveBorrowings"]
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive
                        responsive-card-table-wrapper">

                <table class="table dashboard-table
                              responsive-card-table mb-0">

                    <thead>

                        <tr>
                            <th>@Localizer["Equipment"]</th>
                            <th>@Localizer["Employee"]</th>
                            <th>@Localizer["BorrowDate"]</th>
                            <th>@Localizer["ExpectedReturnDate"]</th>
                            <th>@Localizer["Status"]</th>

                            <th class="text-center">
                                @Localizer["Details"]
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.RecentBorrowings)
                        {
                            var isOverdue =
                                item.ExpectedReturnDate.Date <
                                DateTime.Today;

                            <tr class="@(isOverdue
                                    ? "overdue-row"
                                    : "")">

                                <td data-label="@Localizer["Equipment"]">

                                    <span class="equipment-name">
                                        @(item.Equipment?.Name ?? "-")
                                    </span>

                                </td>

                                <td data-label="@Localizer["Employee"]">
                                    @(item.Employee?.FullName ?? "-")
                                </td>

                                <td data-label="@Localizer["BorrowDate"]">
                                    @item.BorrowDate.ToString("yyyy/MM/dd")
                                </td>

                                <td data-label="@Localizer["ExpectedReturnDate"]">
                                    @item.ExpectedReturnDate.ToString("yyyy/MM/dd")
                                </td>

                                <td data-label="@Localizer["Status"]">

                                    @if (isOverdue)
                                    {
                                        <span class="status-badge overdue">
                                            @Localizer["Overdue"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge on-time">
                                            @Localizer["OnTime"]
                                        </span>
                                    }

                                </td>

                                <td data-label="@Localizer["Details"]">

                                    <div class="responsive-actions">

                                        <a asp-controller="BorrowingRecords"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">

                                            @Localizer["Details"]
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>