@model EquipmentManagement.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "لوحة التحكم";
}

<div dir="rtl">

    <div class="mb-4">
        <h1>لوحة التحكم</h1>
        <p class="text-muted">
            ملخص حالة المعدات والاستعارات والموظفين
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-xl-4">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">
                        إجمالي المعدات
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.TotalEquipment
                    </p>
                </div>

                <div class="card-footer bg-transparent">
                    <a asp-controller="Equipment" asp-action="Index" class="text-decoration-none">
                        عرض المعدات
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">
                        المعدات المتاحة
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.AvailableEquipment
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card border-warning shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-warning">
                        المعدات المستعارة
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.BorrowedEquipment
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-info">
                        عدد الموظفين
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.TotalEmployees
                    </p>
                </div>

                <div class="card-footer bg-transparent">
                    <a asp-controller="Employees" asp-action="Index" class="text-decoration-none">
                        عرض الموظفين
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card border-secondary shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-secondary">
                        الاستعارات النشطة
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.ActiveBorrowings
                    </p>
                </div>

                <div class="card-footer bg-transparent">
                    <a asp-controller="BorrowingRecords" asp-action="Index" class="text-decoration-none">
                        عرض الاستعارات
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card border-danger shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">
                        الاستعارات المتأخرة
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.OverdueBorrowings
                    </p>
                </div>

                @if (Model.OverdueBorrowings > 0)
                {
                    <div class="card-footer bg-danger-subtle text-danger">
                        توجد معدات تجاوزت موعد الإرجاع.
                    </div>
                }
                else
                {
                    <div class="card-footer bg-success-subtle text-success">
                        لا توجد استعارات متأخرة.
                    </div>
                }
            </div>

        </div>

        <div class="card shadow-sm mt-5">

            <div class="card-header bg-dark text-white
                d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    آخر الاستعارات النشطة
                </h5>

                <a asp-controller="BorrowingRecords" asp-action="Index" class="btn btn-light btn-sm">
                    عرض جميع الاستعارات
                </a>

            </div>

            <div class="card-body">

                @if (!Model.RecentBorrowings.Any())
                {
                    <div class="alert alert-info mb-0">
                        لا توجد استعارات نشطة حاليًا.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-bordered
                            table-striped align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>المعدة</th>
                                    <th>الموظف</th>
                                    <th>تاريخ الاستعارة</th>
                                    <th>موعد الإرجاع</th>
                                    <th>الحالة</th>
                                    <th>التفاصيل</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.RecentBorrowings)
                                {
                                    var isOverdue =
                                        item.ExpectedReturnDate.Date <
                                        DateTime.Today;

                                    <tr class="@(isOverdue ? "table-danger" : "")">

                                        <td>
                                            @(item.Equipment?.Name ?? "-")
                                        </td>

                                        <td>
                                            @(item.Employee?.FullName ?? "-")
                                        </td>

                                        <td>
                                            @item.BorrowDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td>
                                            @item.ExpectedReturnDate.ToString(
                                                "yyyy/MM/dd"
                                            )
                                        </td>

                                        <td>
                                            @if (isOverdue)
                                            {
                                                <span class="badge bg-danger">
                                                    متأخرة
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    ضمن الموعد
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <a asp-controller="BorrowingRecords" asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm">
                                                التفاصيل
                                            </a>
                                        </td>

                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>

</div>