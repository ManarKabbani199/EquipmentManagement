@model EquipmentManagement.Web.Models.DashboardViewModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Dashboard"];
}

<div>

    <div class="mb-4">

        <h1>@Localizer["Dashboard"]</h1>

        <p class="text-muted">
            @Localizer["DashboardSummary"]
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-6 col-xl-4">

            <div class="card border-primary shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title text-primary">
                        @Localizer["TotalEquipment"]
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.TotalEquipment
                    </p>

                </div>

                <div class="card-footer bg-transparent">

                    <a asp-controller="Equipment"
                       asp-action="Index"
                       class="text-decoration-none">

                        @Localizer["ViewEquipment"]

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-4">

            <div class="card border-success shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title text-success">
                        @Localizer["AvailableEquipment"]
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.AvailableEquipment
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-4">

            <div class="card border-warning shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title text-warning">
                        @Localizer["BorrowedEquipment"]
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.BorrowedEquipment
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-4">

            <div class="card border-info shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title text-info">
                        @Localizer["TotalEmployees"]
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.TotalEmployees
                    </p>

                </div>

                <div class="card-footer bg-transparent">

                    <a asp-controller="Employees"
                       asp-action="Index"
                       class="text-decoration-none">

                        @Localizer["ViewEmployees"]

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-4">

            <div class="card border-secondary shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title text-secondary">
                        @Localizer["ActiveBorrowings"]
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.ActiveBorrowings
                    </p>

                </div>

                <div class="card-footer bg-transparent">

                    <a asp-controller="BorrowingRecords"
                       asp-action="Index"
                       class="text-decoration-none">

                        @Localizer["ViewBorrowings"]

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-4">

            <div class="card border-danger shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title text-danger">
                        @Localizer["OverdueBorrowings"]
                    </h5>

                    <p class="display-5 fw-bold mb-0">
                        @Model.OverdueBorrowings
                    </p>

                </div>

                @if (Model.OverdueBorrowings > 0)
                {
                    <div class="card-footer bg-danger-subtle text-danger">
                        @Localizer["OverdueEquipmentWarning"]
                    </div>
                }
                else
                {
                    <div class="card-footer bg-success-subtle text-success">
                        @Localizer["NoOverdueBorrowings"]
                    </div>
                }

            </div>

        </div>

    </div>

    <div class="card shadow-sm mt-5">

        <div class="card-header bg-dark text-white
                    d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                @Localizer["RecentActiveBorrowings"]
            </h5>

            <a asp-controller="BorrowingRecords"
               asp-action="Index"
               class="btn btn-light btn-sm">

                @Localizer["ViewAllBorrowings"]

            </a>

        </div>

        <div class="card-body">

            @if (!Model.RecentBorrowings.Any())
            {
                <div class="alert alert-info mb-0">
                    @Localizer["NoActiveBorrowings"]
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered
                                  table-striped align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>@Localizer["Equipment"]</th>
                                <th>@Localizer["Employee"]</th>
                                <th>@Localizer["BorrowDate"]</th>
                                <th>@Localizer["ExpectedReturnDate"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Details"]</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.RecentBorrowings)
                            {
                                var isOverdue =
                                    item.ExpectedReturnDate.Date <
                                    DateTime.Today;

                                <tr class="@(isOverdue ? "table-danger" : "")">

                                    <td>
                                        @(item.Equipment?.Name ?? "-")
                                    </td>

                                    <td>
                                        @(item.Employee?.FullName ?? "-")
                                    </td>

                                    <td>
                                        @item.BorrowDate.ToString("yyyy/MM/dd")
                                    </td>

                                    <td>
                                        @item.ExpectedReturnDate.ToString("yyyy/MM/dd")
                                    </td>

                                    <td>

                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger">
                                                @Localizer["Overdue"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @Localizer["OnTime"]
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="BorrowingRecords"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm">

                                            @Localizer["Details"]

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>