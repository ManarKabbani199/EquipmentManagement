@model IEnumerable<EquipmentManagement.Domain.Entities.BorrowingRecord>

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["BorrowingRecords"];

    var currentPage =
        (int)(ViewData["CurrentPage"] ?? 1);

    var totalPages =
        (int)(ViewData["TotalPages"] ?? 0);

    var confirmReturn =
        Localizer["ConfirmReturnEquipment"].Value;
}

<div class="d-flex justify-content-between
            align-items-center mb-4">

    <h1>@Localizer["BorrowingRecords"]</h1>

    <a asp-action="Create"
       class="btn btn-primary">

        @Localizer["BorrowEquipment"]

    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-action="Index"
              method="get"
              class="row g-3">

            <div class="col-md-5">

                <label class="form-label">
                    @Localizer["Search"]
                </label>

                <input type="text"
                       name="search"
                       value="@ViewData["CurrentSearch"]"
                       class="form-control"
                       placeholder="@Localizer["BorrowingSearchPlaceholder"]" />

            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-4">

                    <label class="form-label">
                        @Localizer["Employee"]
                    </label>

                    <select name="employeeId"
                            class="form-select"
                            asp-items="ViewBag.EmployeeId">

                        <option value="">
                            @Localizer["AllEmployees"]
                        </option>

                    </select>

                </div>
            }

            <div class="col-md-4">

                <label class="form-label">
                    @Localizer["BorrowingStatus"]
                </label>

                <select name="status"
                        class="form-select">

                    <option value="">
                        @Localizer["AllStatuses"]
                    </option>

                    <option value="active"
                            selected="@(ViewData["CurrentStatus"]?.ToString() == "active")">

                        @Localizer["Active"]

                    </option>

                    <option value="returned"
                            selected="@(ViewData["CurrentStatus"]?.ToString() == "returned")">

                        @Localizer["Returned"]

                    </option>

                    <option value="overdue"
                            selected="@(ViewData["CurrentStatus"]?.ToString() == "overdue")">

                        @Localizer["Overdue"]

                    </option>

                </select>

            </div>

            <div class="col-md-3 d-flex
                        align-items-end gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    @Localizer["Search"]

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    @Localizer["Reset"]

                </a>

            </div>

            <div class="col-12">

                <p class="text-muted mb-0">

                    @Localizer["ResultsCount"]:

                    <strong>
                        @(ViewData["TotalRecords"] ?? 0)
                    </strong>

                </p>

            </div>

        </form>

    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @Localizer["NoBorrowingRecords"]
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered
                      table-striped align-middle">

            <thead class="table-dark">

                <tr>
                    <th>@Localizer["Image"]</th>
                    <th>@Localizer["Equipment"]</th>
                    <th>@Localizer["Employee"]</th>
                    <th>@Localizer["BorrowDate"]</th>
                    <th>@Localizer["ExpectedReturnDate"]</th>
                    <th>@Localizer["ActualReturnDate"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            @if (!string.IsNullOrWhiteSpace(
                                item.Equipment?.ImagePath))
                            {
                                <a href="@item.Equipment.ImagePath"
                                   target="_blank"
                                   rel="noopener noreferrer">

                                    <img src="@item.Equipment.ImagePath"
                                         alt="@Localizer[
                                             "EquipmentImageAlt",
                                             item.Equipment.Name
                                         ]"
                                         class="img-thumbnail"
                                         style="width:90px;
                                                height:70px;
                                                object-fit:cover;" />

                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    @Localizer["NoImage"]
                                </span>
                            }

                        </td>

                        <td>

                            <strong>
                                @(item.Equipment?.Name ?? "-")
                            </strong>

                            @if (!string.IsNullOrWhiteSpace(
                                item.Equipment?.Description))
                            {
                                <div class="text-muted small">
                                    @item.Equipment.Description
                                </div>
                            }

                        </td>

                        <td>
                            @(item.Employee?.FullName ?? "-")
                        </td>

                        <td>
                            @item.BorrowDate.ToString("g")
                        </td>

                        <td>
                            @item.ExpectedReturnDate.ToString("g")
                        </td>

                        <td>

                            @if (item.ActualReturnDate.HasValue)
                            {
                                @item.ActualReturnDate.Value.ToString("g")
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </td>

                        <td>

                            @if (item.IsReturned)
                            {
                                <span class="badge bg-success">
                                    @Localizer["Returned"]
                                </span>
                            }
                            else if (
                                item.ExpectedReturnDate <
                                DateTime.Now)
                            {
                                <span class="badge bg-danger">
                                    @Localizer["Overdue"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @Localizer["Active"]
                                </span>
                            }

                        </td>

                        <td>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">

                                    @Localizer["Details"]

                                </a>

                                @if (User.IsInRole("Admin") &&
                                     !item.IsReturned)
                                {
                                    <form asp-action="ReturnEquipment"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('@confirmReturn');">

                                        <button type="submit"
                                                class="btn btn-success btn-sm">

                                            @Localizer["ReturnEquipment"]

                                        </button>

                                    </form>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4"
             aria-label="@Localizer["Pagination"]">

            <ul class="pagination justify-content-center">

                <li class="page-item
                    @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(currentPage - 1)"
                       asp-route-search="@ViewData["CurrentSearch"]"
                       asp-route-status="@ViewData["CurrentStatus"]"
                       asp-route-employeeId="@ViewData["CurrentEmployeeId"]">

                        @Localizer["Previous"]

                    </a>

                </li>

                @for (var pageIndex = 1;
                      pageIndex <= totalPages;
                      pageIndex++)
                {
                    <li class="page-item
                        @(pageIndex == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@pageIndex"
                           asp-route-search="@ViewData["CurrentSearch"]"
                           asp-route-status="@ViewData["CurrentStatus"]"
                           asp-route-employeeId="@ViewData["CurrentEmployeeId"]">

                            @pageIndex

                        </a>

                    </li>
                }

                <li class="page-item
                    @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(currentPage + 1)"
                       asp-route-search="@ViewData["CurrentSearch"]"
                       asp-route-status="@ViewData["CurrentStatus"]"
                       asp-route-employeeId="@ViewData["CurrentEmployeeId"]">

                        @Localizer["Next"]

                    </a>

                </li>

            </ul>

        </nav>
    }
}