@model EquipmentManagement.Domain.Entities.BorrowingRecord

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["BorrowingDetails"];

    var isAdmin =
        User.IsInRole("Admin");

    var isOverdue =
        !Model.IsReturned &&
        Model.ExpectedReturnDate < DateTime.Now;
}

<div class="borrowing-details-page">

    <!-- عنوان الصفحة -->
    <section class="borrowing-details-header mb-4">

        <div class="borrowing-details-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="borrowing-details-title mb-1">
                    @Localizer["BorrowingDetails"]
                </h1>

                <p class="mb-0 text-white-50">
                    @(Model.Equipment?.Name ?? "-")
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]
            </a>

        </div>

    </section>

    <!-- بطاقة التفاصيل -->
    <section class="borrowing-details-card">

        <div class="row g-0">

            <!-- صورة المعدة -->
            <div class="col-lg-6">

                <div class="borrowing-details-image-area">

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Equipment?.ImagePath))
                    {
                        <a href="@Model.Equipment.ImagePath"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@Model.Equipment.ImagePath"
                                 alt="@Localizer[
                                     "EquipmentImageAlt",
                                     Model.Equipment.Name
                                 ]"
                                 class="borrowing-details-image" />

                        </a>
                    }
                    else
                    {
                        <div class="borrowing-image-placeholder">

                            <span class="borrowing-image-placeholder-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect x="3"
                                          y="3"
                                          width="18"
                                          height="18"
                                          rx="2" />

                                    <circle cx="8.5"
                                            cy="8.5"
                                            r="1.5" />

                                    <path d="m21 15-5-5L5 21" />

                                </svg>

                            </span>

                            <p class="mb-0">
                                @Localizer["NoImageForEquipment"]
                            </p>

                        </div>
                    }

                </div>

            </div>

            <!-- بيانات الاستعارة -->
            <div class="col-lg-6">

                <div class="borrowing-details-information">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <div>

                            <h2 class="borrowing-equipment-name">
                                @(Model.Equipment?.Name ?? "-")
                            </h2>

                            <p class="borrowing-employee-name">
                                @(Model.Employee?.FullName ?? "-")
                            </p>

                        </div>

                        @if (Model.IsReturned)
                        {
                            <span class="borrowing-details-status returned">
                                @Localizer["Returned"]
                            </span>
                        }
                        else if (isOverdue)
                        {
                            <span class="borrowing-details-status overdue">
                                @Localizer["Overdue"]
                            </span>
                        }
                        else
                        {
                            <span class="borrowing-details-status active">
                                @Localizer["Active"]
                            </span>
                        }

                    </div>

                    <dl class="borrowing-details-list">

                        <div class="borrowing-details-row">

                            <dt class="borrowing-details-label">
                                @Localizer["EquipmentName"]
                            </dt>

                            <dd class="borrowing-details-value fw-semibold">
                                @(Model.Equipment?.Name ?? "-")
                            </dd>

                        </div>

                        <div class="borrowing-details-row">

                            <dt class="borrowing-details-label">
                                @Localizer["EmployeeName"]
                            </dt>

                            <dd class="borrowing-details-value">
                                @(Model.Employee?.FullName ?? "-")
                            </dd>

                        </div>

                        <div class="borrowing-details-row">

                            <dt class="borrowing-details-label">
                                @Localizer["BorrowDate"]
                            </dt>

                            <dd class="borrowing-details-value">
                                @Model.BorrowDate.ToString("g")
                            </dd>

                        </div>

                        <div class="borrowing-details-row">

                            <dt class="borrowing-details-label">
                                @Localizer["ExpectedReturnDate"]
                            </dt>

                            <dd class="borrowing-details-value
                                       @(isOverdue
                                           ? "borrowing-overdue-date"
                                           : "")">

                                @Model.ExpectedReturnDate.ToString("g")

                            </dd>

                        </div>

                        <div class="borrowing-details-row">

                            <dt class="borrowing-details-label">
                                @Localizer["ActualReturnDate"]
                            </dt>

                            <dd class="borrowing-details-value">

                                @if (Model.ActualReturnDate.HasValue)
                                {
                                    @Model.ActualReturnDate.Value.ToString("g")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                        <div class="borrowing-details-row">

                            <dt class="borrowing-details-label">
                                @Localizer["BorrowingStatus"]
                            </dt>

                            <dd class="borrowing-details-value">

                                @if (Model.IsReturned)
                                {
                                    <span class="borrowing-details-status returned">
                                        @Localizer["Returned"]
                                    </span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="borrowing-details-status overdue">
                                        @Localizer["Overdue"]
                                    </span>
                                }
                                else
                                {
                                    <span class="borrowing-details-status active">
                                        @Localizer["Active"]
                                    </span>
                                }

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <!-- أزرار الصفحة -->
        <div class="borrowing-details-footer">

            <div class="d-flex gap-2 flex-wrap">

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]
                </a>

                @if (isAdmin && !Model.IsReturned)
                {
                    <button type="button"
                            class="btn btn-success px-4"
                            data-bs-toggle="modal"
                            data-bs-target="#returnEquipmentModal">

                        @Localizer["ReturnEquipment"]
                    </button>
                }

            </div>

        </div>

    </section>

</div>

@if (isAdmin && !Model.IsReturned)
{
    <!-- نافذة تأكيد استرجاع المعدة -->
    <div class="modal fade"
         id="returnEquipmentModal"
         tabindex="-1"
         aria-labelledby="returnEquipmentModalLabel"
         aria-describedby="returnEquipmentModalDescription"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content return-equipment-modal">

                <div class="modal-body text-center">

                    <div class="return-equipment-modal-icon"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M20 11a8.1 8.1 0 1 1-2.3-5.7" />
                            <path d="M20 4v7h-7" />
                            <path d="m9 12 2 2 4-4" />

                        </svg>

                    </div>

                    <h2 id="returnEquipmentModalLabel"
                        class="h4 fw-bold mb-3">

                        @Localizer["ReturnEquipment"]
                    </h2>

                    <p id="returnEquipmentModalDescription"
                       class="text-muted mb-2">

                        @Localizer["ConfirmReturnEquipment"]
                    </p>

                    <div class="return-equipment-name">
                        @(Model.Equipment?.Name ?? "-")
                    </div>

                </div>

                <div class="modal-footer
                            justify-content-center gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">

                        @Localizer["Cancel"]
                    </button>

                    <form asp-action="ReturnEquipment"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success px-4">

                            @Localizer["ReturnEquipment"]
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}