@model EquipmentManagement.Domain.Entities.BorrowingRecord

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["BorrowingDetails"];

    var confirmReturn =
        Localizer["ConfirmReturnEquipment"].Value;
}

<div class="row justify-content-center">

    <div class="col-md-9 col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-info">

                <h1 class="h4 mb-0">
                    @Localizer["BorrowingDetails"]
                </h1>

            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(
                    Model.Equipment?.ImagePath))
                {
                    <div class="text-center mb-4">

                        <a href="@Model.Equipment.ImagePath"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@Model.Equipment.ImagePath"
                                 alt="@Localizer[
                                     "EquipmentImageAlt",
                                     Model.Equipment.Name
                                 ]"
                                 class="img-thumbnail"
                                 style="width:280px;
                                        height:210px;
                                        object-fit:contain;" />

                        </a>

                    </div>
                }

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        @Localizer["EquipmentName"]
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Equipment?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["EmployeeName"]
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Employee?.FullName ?? "-")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["BorrowDate"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.BorrowDate.ToString("g")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["ExpectedReturnDate"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.ExpectedReturnDate.ToString("g")
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["ActualReturnDate"]
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.ActualReturnDate.HasValue)
                        {
                            @Model.ActualReturnDate.Value.ToString("g")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["BorrowingStatus"]
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.IsReturned)
                        {
                            <span class="badge bg-success">
                                @Localizer["Returned"]
                            </span>
                        }
                        else if (
                            Model.ExpectedReturnDate <
                            DateTime.Now)
                        {
                            <span class="badge bg-danger">
                                @Localizer["Overdue"]
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @Localizer["Active"]
                            </span>
                        }

                    </dd>

                </dl>

            </div>

            <div class="card-footer">

                <div class="d-flex gap-2 flex-wrap">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        @Localizer["BackToList"]

                    </a>

                    @if (User.IsInRole("Admin") &&
                         !Model.IsReturned)
                    {
                        <form asp-action="ReturnEquipment"
                              asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('@confirmReturn');">

                            <button type="submit"
                                    class="btn btn-success">

                                @Localizer["ReturnEquipment"]

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</div>