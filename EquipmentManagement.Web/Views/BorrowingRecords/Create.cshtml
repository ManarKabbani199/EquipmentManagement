@model EquipmentManagement.Domain.Entities.BorrowingRecord

@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["BorrowEquipment"];

    var equipmentImages =
        ViewData["EquipmentImages"]
            as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">

                <h1 class="h4 mb-0">
                    @Localizer["BorrowEquipment"]
                </h1>

            </div>

            <div class="card-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-3">

                        <label asp-for="EquipmentId"
                               class="form-label">

                            @Localizer["Equipment"]

                        </label>

                        <select asp-for="EquipmentId"
                                class="form-select"
                                asp-items="ViewBag.EquipmentId">

                            <option value="">
                                @Localizer["SelectEquipment"]
                            </option>

                        </select>

                        <span asp-validation-for="EquipmentId"
                              class="text-danger">
                        </span>

                        <div id="equipmentImageContainer"
                             class="mt-3 text-center"
                             style="display:none;">

                            <label class="form-label d-block">
                                @Localizer["SelectedEquipmentImage"]
                            </label>

                            <img id="equipmentImage"
                                 src=""
                                 alt="@Localizer["SelectedEquipmentImage"]"
                                 class="img-thumbnail"
                                 style="width:260px;
                                        height:200px;
                                        object-fit:contain;" />

                        </div>

                        <div id="equipmentNoImage"
                             class="alert alert-secondary mt-3"
                             style="display:none;">

                            @Localizer["NoImageForEquipment"]

                        </div>

                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-3">

                            <label asp-for="EmployeeId"
                                   class="form-label">

                                @Localizer["Employee"]

                            </label>

                            <select asp-for="EmployeeId"
                                    class="form-select"
                                    asp-items="ViewBag.EmployeeId">

                                <option value="">
                                    @Localizer["SelectEmployee"]
                                </option>

                            </select>

                            <span asp-validation-for="EmployeeId"
                                  class="text-danger">
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            @Localizer["CurrentEmployeeBorrowingNotice"]
                        </div>
                    }

                    <div class="mb-3">

                        <label asp-for="ExpectedReturnDate"
                               class="form-label">

                            @Localizer["ExpectedReturnDate"]

                        </label>

                        <input asp-for="ExpectedReturnDate"
                               class="form-control" />

                        <span asp-validation-for="ExpectedReturnDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            @Localizer["ConfirmBorrowing"]

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            @Localizer["BackToList"]

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const equipmentImages =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            equipmentImages
                        )
                    );

                const equipmentSelect =
                    document.getElementById(
                        "EquipmentId"
                    );

                const imageContainer =
                    document.getElementById(
                        "equipmentImageContainer"
                    );

                const equipmentImage =
                    document.getElementById(
                        "equipmentImage"
                    );

                const noImageMessage =
                    document.getElementById(
                        "equipmentNoImage"
                    );

                function updateEquipmentImage() {
                    const selectedId =
                        equipmentSelect.value;

                    const imagePath =
                        equipmentImages[selectedId];

                    imageContainer.style.display =
                        "none";

                    noImageMessage.style.display =
                        "none";

                    equipmentImage.removeAttribute(
                        "src"
                    );

                    if (!selectedId) {
                        return;
                    }

                    if (imagePath) {
                        equipmentImage.src =
                            imagePath;

                        imageContainer.style.display =
                            "block";
                    }
                    else {
                        noImageMessage.style.display =
                            "block";
                    }
                }

                equipmentSelect.addEventListener(
                    "change",
                    updateEquipmentImage
                );

                updateEquipmentImage();
            }
        );
    </script>
}