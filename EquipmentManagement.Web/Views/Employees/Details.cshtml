@model EquipmentManagement.Domain.Entities.Employee

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EmployeeDetails"];
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-info">

                <h1 class="h4 mb-0">
                    @Localizer["EmployeeDetails"]
                </h1>

            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        @Localizer["FullName"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.FullName
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Email"]
                    </dt>

                    <dd class="col-sm-8">

                        <a href="mailto:@Model.Email">
                            @Model.Email
                        </a>

                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Department"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Department
                    </dd>

                </dl>

            </div>

            <div class="card-footer">

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">

                        @Localizer["Edit"]

                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        @Localizer["BackToList"]

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>