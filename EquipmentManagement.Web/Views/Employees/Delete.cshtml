@model EquipmentManagement.Domain.Entities.Employee

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["DeleteEmployee"];

    var hasIdentityAccount =
        !string.IsNullOrWhiteSpace(
            Model.IdentityUserId
        );
}

<div class="employee-page
            employee-theme-delete
            employee-read-page">

    <section class="employee-page-header mb-4">

        <div class="employee-page-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="employee-page-title mb-1">
                    @Localizer["DeleteEmployee"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.FullName
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <div class="employee-delete-warning mb-4">

        <span class="employee-delete-warning-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 aria-hidden="true">

                <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />

            </svg>

        </span>

        <div>

            <strong class="d-block mb-1">
                @Localizer["DeleteConfirmation"]
            </strong>

            <span>
                @Localizer["DeleteEmployeeWarning"]
            </span>

        </div>

    </div>

    <section class="employee-page-card">

        <div class="row g-0">

            <div class="col-md-4">

                <div class="employee-page-profile">

                    <div>

                        <span class="employee-profile-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">

                                <circle cx="10"
                                        cy="8"
                                        r="4" />

                                <path d="M3 21v-2a7 7 0 0 1 11-5.75" />
                                <path d="M16 17l5 5" />
                                <path d="M21 17l-5 5" />

                            </svg>

                        </span>

                        <p class="employee-profile-name">
                            @Model.FullName
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-8">

                <div class="employee-page-content">

                    <h2 class="employee-page-name">
                        @Model.FullName
                    </h2>

                    <dl class="employee-page-list">

                        <div class="employee-page-row">

                            <dt class="employee-page-label">
                                @Localizer["FullName"]
                            </dt>

                            <dd class="employee-page-value fw-semibold">

                                @(string.IsNullOrWhiteSpace(Model.FullName)
                                    ? "-"
                                    : Model.FullName)

                            </dd>

                        </div>

                        <div class="employee-page-row">

                            <dt class="employee-page-label">
                                @Localizer["Email"]
                            </dt>

                            <dd class="employee-page-value">

                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <a href="mailto:@Model.Email"
                                       class="employee-email">

                                        @Model.Email

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                        <div class="employee-page-row">

                            <dt class="employee-page-label">
                                @Localizer["Department"]
                            </dt>

                            <dd class="employee-page-value">

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.Department))
                                {
                                    <span class="employee-department">
                                        @Model.Department
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                        <div class="employee-page-row">

                            <dt class="employee-page-label">
                                @Localizer["Login"]
                            </dt>

                            <dd class="employee-page-value">

                                @if (hasIdentityAccount)
                                {
                                    <span class="employee-account-status">
                                        @Localizer["Employee"]
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <div class="employee-page-actions">

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-danger px-4"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteEmployeeModal">

                    @Localizer["ConfirmDelete"]

                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["Cancel"]

                </a>

            </div>

        </div>

    </section>

</div>

<!-- نافذة تأكيد حذف الموظف -->
<div class="modal fade"
     id="deleteEmployeeModal"
     tabindex="-1"
     aria-labelledby="deleteEmployeeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <form asp-action="Delete"
              method="post"
              class="modal-content employee-delete-modal">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div class="modal-header employee-delete-modal-header">

                <h2 class="modal-title h5 mb-0"
                    id="deleteEmployeeModalLabel">

                    @Localizer["DeleteEmployee"]

                </h2>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Cancel"]">
                </button>

            </div>

            <div class="modal-body p-4 text-center">

                <span class="employee-delete-modal-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />

                    </svg>

                </span>

                <h3 class="h5 fw-bold mb-3">
                    @Localizer["DeleteConfirmation"]
                </h3>

                <p class="text-muted mb-3">
                    @Localizer["DeleteEmployeeWarning"]
                </p>

                <div class="employee-delete-modal-name">
                    @Model.FullName
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary px-4"
                        data-bs-dismiss="modal">

                    @Localizer["Cancel"]

                </button>

                <button type="submit"
                        class="btn btn-danger px-4">

                    @Localizer["ConfirmDelete"]

                </button>

            </div>

        </form>

    </div>

</div>