@model IEnumerable<EquipmentManagement.Domain.Entities.Employee>

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Employees"];

    var employees = Model.ToList();
}

<div class="d-flex flex-column flex-sm-row
            justify-content-between
            align-items-sm-center gap-3 mb-4">

    <h1 class="mb-0">
        @Localizer["Employees"]
    </h1>

    <a asp-action="Create"
       class="btn btn-primary">

        @Localizer["CreateNewEmployee"]
    </a>

</div>

<!-- رسالة النجاح -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success
                alert-dismissible fade show shadow-sm"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="@Localizer["Cancel"]">
        </button>

    </div>
}

<!-- رسالة الخطأ -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger
                alert-dismissible fade show shadow-sm"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="@Localizer["Cancel"]">
        </button>

    </div>
}

@if (employees.Count == 0)
{
    <div class="alert alert-info shadow-sm">
        @Localizer["NoEmployees"]
    </div>
}
else
{
    <div class="table-responsive
                responsive-card-table-wrapper">

        <table class="table table-bordered
                      table-striped align-middle
                      responsive-card-table mb-0">

            <thead class="table-dark">

                <tr>
                    <th>@Localizer["FullName"]</th>
                    <th>@Localizer["Email"]</th>
                    <th>@Localizer["Department"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in employees)
                {
                    <tr>

                        <!-- اسم الموظف -->
                        <td data-label="@Localizer["FullName"]">

                            <span class="fw-semibold">
                                @item.FullName
                            </span>

                        </td>

                        <!-- البريد الإلكتروني -->
                        <td data-label="@Localizer["Email"]">

                            @if (!string.IsNullOrWhiteSpace(item.Email))
                            {
                                <a href="mailto:@item.Email"
                                   class="text-decoration-none"
                                   dir="ltr">

                                    @item.Email
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }

                        </td>

                        <!-- القسم -->
                        <td data-label="@Localizer["Department"]">

                            @(string.IsNullOrWhiteSpace(item.Department)
                                ? "-"
                                : item.Department)

                        </td>

                        <!-- الإجراءات -->
                        <td data-label="@Localizer["Actions"]">

                            <div class="responsive-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    @Localizer["Edit"]
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">

                                    @Localizer["Details"]
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">

                                    @Localizer["Delete"]
                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}