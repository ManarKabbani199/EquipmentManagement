@model EquipmentManagement.Domain.Entities.Employee

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["EditEmployee"];
}

<style>
    .employee-edit-header {
        position: relative;
        overflow: hidden;
        padding: 1.75rem;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(255, 255, 255, 0.2),
                transparent 35%
            ),
            linear-gradient(135deg, #0f172a, #d97706);
        border-radius: 1.2rem;
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.12);
    }

    .employee-edit-header-content {
        position: relative;
        z-index: 1;
    }

    .employee-edit-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
    }

    .employee-edit-card {
        overflow: hidden;
        background: white;
        border: 0;
        border-radius: 1.1rem;
        box-shadow: 0 0.6rem 1.8rem rgba(15, 23, 42, 0.08);
    }

    .employee-edit-icon-area {
        display: flex;
        min-height: 100%;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        color: #d97706;
        background: #fffbeb;
        border-inline-end: 1px solid #e2e8f0;
    }

    .employee-edit-icon {
        display: inline-flex;
        width: 8rem;
        height: 8rem;
        align-items: center;
        justify-content: center;
        background: #fef3c7;
        border-radius: 50%;
    }

    .employee-edit-icon svg {
        width: 4rem;
        height: 4rem;
    }

    .employee-edit-content {
        padding: 1.5rem;
    }

    .employee-edit-card .form-label {
        color: #334155;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .employee-edit-card .form-control {
        min-height: 2.8rem;
        border-color: #cbd5e1;
        border-radius: 0.7rem;
    }

    .employee-edit-card .form-control:focus {
        border-color: #d97706;
        box-shadow: 0 0 0 0.2rem rgba(217, 119, 6, 0.14);
    }

    .employee-edit-card .input-validation-error {
        border-color: #dc2626;
    }

    .validation-summary-valid {
        display: none;
    }

    .employee-account-notice {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        margin-bottom: 1.25rem;
        padding: 1rem;
        color: #075985;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 0.8rem;
    }

    .employee-account-notice svg {
        width: 1.4rem;
        height: 1.4rem;
        flex: 0 0 1.4rem;
    }

    .employee-edit-actions {
        padding: 1.25rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 767.98px) {
        .employee-edit-icon-area {
            min-height: 12rem;
            border-inline-end: 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .employee-edit-icon {
            width: 6rem;
            height: 6rem;
        }

        .employee-edit-icon svg {
            width: 3rem;
            height: 3rem;
        }
    }

    @@media (max-width: 575.98px) {
        .employee-edit-header {
            padding: 1.3rem;
            border-radius: 1rem;
        }

        .employee-edit-header-content {
            align-items: stretch !important;
            flex-direction: column;
        }

        .employee-edit-header .btn {
            width: 100%;
        }

        .employee-edit-content {
            padding: 1.2rem;
        }

        .employee-edit-actions {
            flex-direction: column;
        }

        .employee-edit-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="employee-edit-page">

    <!-- عنوان الصفحة -->
    <section class="employee-edit-header mb-4">

        <div class="employee-edit-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="employee-edit-title mb-1">
                    @Localizer["EditEmployee"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.FullName
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]
            </a>

        </div>

    </section>

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <!-- رقم سجل الموظف فقط -->
        <input type="hidden"
               asp-for="Id" />

        <div class="employee-edit-card">

            <div class="row g-0">

                <!-- أيقونة الموظف -->
                <div class="col-md-4">

                    <div class="employee-edit-icon-area">

                        <span class="employee-edit-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <circle cx="10"
                                        cy="8"
                                        r="4" />

                                <path d="M3 21v-2a7 7 0 0 1 11-5.75" />
                                <path d="M16 19h6" />
                                <path d="M19 16v6" />

                            </svg>

                        </span>

                    </div>

                </div>

                <!-- حقول الموظف -->
                <div class="col-md-8">

                    <div class="employee-edit-content">

                        <!-- أخطاء النموذج -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="employee-account-notice">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />

                                <path d="M12 11v5" />
                                <path d="M12 8h.01" />

                            </svg>

                            <span>
                                @Localizer["Employee"]
                            </span>

                        </div>

                        <!-- الاسم الكامل -->
                        <div class="mb-4">

                            <label asp-for="FullName"
                                   class="form-label">

                                @Localizer["FullName"]
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   autofocus />

                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- البريد الإلكتروني -->
                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">

                                @Localizer["Email"]
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="email"
                                   dir="ltr" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- القسم -->
                        <div>

                            <label asp-for="Department"
                                   class="form-label">

                                @Localizer["Department"]
                            </label>

                            <input asp-for="Department"
                                   class="form-control" />

                            <span asp-validation-for="Department"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <!-- الأزرار -->
            <div class="employee-edit-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-warning px-4">

                    @Localizer["SaveChanges"]
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]
                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}