@model EquipmentManagement.Domain.Entities.Employee

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EditEmployee"];
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-warning">

                <h1 class="h4 mb-0">
                    @Localizer["EditEmployee"]
                </h1>

            </div>

            <div class="card-body">

                <form asp-action="Edit"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="mb-3">

                        <label asp-for="FullName"
                               class="form-label">

                            @Localizer["FullName"]

                        </label>

                        <input asp-for="FullName"
                               class="form-control" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">

                            @Localizer["Email"]

                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Department"
                               class="form-label">

                            @Localizer["Department"]

                        </label>

                        <input asp-for="Department"
                               class="form-control" />

                        <span asp-validation-for="Department"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-warning">

                            @Localizer["SaveChanges"]

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            @Localizer["BackToList"]

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}