@model EquipmentManagement.Domain.Entities.Employee

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["EditEmployee"];
}

<div class="employee-page employee-theme-edit">

    <section class="employee-page-header mb-4">

        <div class="employee-page-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="employee-page-title mb-1">
                    @Localizer["EditEmployee"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.FullName
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <div class="employee-page-card">

            <div class="row g-0">

                <div class="col-md-4">

                    <div class="employee-page-profile">

                        <span class="employee-profile-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">

                                <circle cx="10"
                                        cy="8"
                                        r="4" />

                                <path d="M3 21v-2a7 7 0 0 1 11-5.75" />
                                <path d="M16 19h6" />
                                <path d="M19 16v6" />

                            </svg>

                        </span>

                    </div>

                </div>

                <div class="col-md-8">

                    <div class="employee-page-content">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="employee-account-notice">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />

                                <path d="M12 11v5" />
                                <path d="M12 8h.01" />

                            </svg>

                            <span>
                                @Localizer["Employee"]
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="FullName"
                                   class="form-label">

                                @Localizer["FullName"]

                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   autofocus />

                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">

                                @Localizer["Email"]

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="email"
                                   dir="ltr" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div>

                            <label asp-for="Department"
                                   class="form-label">

                                @Localizer["Department"]

                            </label>

                            <input asp-for="Department"
                                   class="form-control" />

                            <span asp-validation-for="Department"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="employee-page-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-warning px-4">

                    @Localizer["SaveChanges"]

                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}