@model EquipmentManagement.Web.Models.CreateEmployeeViewModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["CreateNewEmployee"];
}

<div class="employee-page employee-theme-create">

    <section class="employee-page-header mb-4">

        <div class="employee-page-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="employee-page-title mb-1">
                    @Localizer["CreateNewEmployee"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Localizer["CreateEmployeeAndAccount"]
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="employee-page-card">

            <div class="px-4 pt-4">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-0"
                     role="alert">
                </div>

            </div>

            <section class="employee-form-section">

                <div class="employee-section-heading">

                    <span class="employee-section-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">

                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 21v-2a8 8 0 0 1 16 0v2" />

                        </svg>

                    </span>

                    <h2 class="employee-section-title">
                        @Localizer["Employees"]
                    </h2>

                </div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">

                            @Localizer["FullName"]

                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               autofocus />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Department"
                               class="form-label">

                            @Localizer["Department"]

                        </label>

                        <input asp-for="Department"
                               class="form-control" />

                        <span asp-validation-for="Department"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <section class="employee-form-section">

                <div class="employee-section-heading">

                    <span class="employee-section-icon account">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">

                            <rect x="3"
                                  y="11"
                                  width="18"
                                  height="10"
                                  rx="2" />

                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />

                        </svg>

                    </span>

                    <h2 class="employee-section-title">
                        @Localizer["Login"]
                    </h2>

                </div>

                <div class="employee-account-notice">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5" />
                        <path d="M12 8h.01" />

                    </svg>

                    <span>
                        @Localizer["CreateEmployeeAndAccount"]
                    </span>

                </div>

                <div class="row g-4">

                    <div class="col-12">

                        <label asp-for="Email"
                               class="form-label">

                            @Localizer["Email"]

                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               autocomplete="email"
                               dir="ltr" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Password"
                               class="form-label">

                            @Localizer["Password"]

                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               dir="ltr" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ConfirmPassword"
                               class="form-label">

                            @Localizer["ConfirmPassword"]

                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               dir="ltr" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <div class="employee-page-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary px-4">

                    @Localizer["CreateEmployeeAndAccount"]

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}