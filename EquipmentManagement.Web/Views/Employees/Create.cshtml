@model EquipmentManagement.Web.Models.CreateEmployeeViewModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["CreateNewEmployee"];
}

<style>
    .employee-create-header {
        position: relative;
        overflow: hidden;
        padding: 1.75rem;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(255, 255, 255, 0.2),
                transparent 35%
            ),
            linear-gradient(135deg, #0f172a, #0891b2);
        border-radius: 1.2rem;
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.12);
    }

    .employee-create-header-content {
        position: relative;
        z-index: 1;
    }

    .employee-create-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
    }

    .employee-create-card {
        overflow: hidden;
        background: white;
        border: 0;
        border-radius: 1.1rem;
        box-shadow: 0 0.6rem 1.8rem rgba(15, 23, 42, 0.08);
    }

    .employee-form-section {
        padding: 1.5rem;
    }

    .employee-form-section + .employee-form-section {
        border-top: 1px solid #e2e8f0;
    }

    .employee-section-heading {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .employee-section-icon {
        display: inline-flex;
        width: 2.8rem;
        height: 2.8rem;
        flex: 0 0 2.8rem;
        align-items: center;
        justify-content: center;
        color: #0891b2;
        background: #cffafe;
        border-radius: 0.8rem;
    }

    .employee-section-icon.account {
        color: #7c3aed;
        background: #ede9fe;
    }

    .employee-section-icon svg {
        width: 1.4rem;
        height: 1.4rem;
    }

    .employee-section-title {
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
    }

    .employee-create-card .form-label {
        color: #334155;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .employee-create-card .form-control {
        min-height: 2.8rem;
        border-color: #cbd5e1;
        border-radius: 0.7rem;
    }

    .employee-create-card .form-control:focus {
        border-color: #0891b2;
        box-shadow: 0 0 0 0.2rem rgba(8, 145, 178, 0.14);
    }

    .employee-create-card .input-validation-error {
        border-color: #dc2626;
    }

    .validation-summary-valid {
        display: none;
    }

    .employee-account-notice {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        margin-bottom: 1.25rem;
        padding: 1rem;
        color: #5b21b6;
        background: #f5f3ff;
        border: 1px solid #ddd6fe;
        border-radius: 0.8rem;
    }

    .employee-account-notice svg {
        width: 1.4rem;
        height: 1.4rem;
        flex: 0 0 1.4rem;
    }

    .employee-form-actions {
        padding: 1.25rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 575.98px) {
        .employee-create-header {
            padding: 1.3rem;
            border-radius: 1rem;
        }

        .employee-create-header-content {
            align-items: stretch !important;
            flex-direction: column;
        }

        .employee-create-header .btn {
            width: 100%;
        }

        .employee-form-section {
            padding: 1.2rem;
        }

        .employee-form-actions {
            flex-direction: column;
        }

        .employee-form-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="employee-create-page">

    <!-- عنوان الصفحة -->
    <section class="employee-create-header mb-4">

        <div class="employee-create-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="employee-create-title mb-1">
                    @Localizer["CreateNewEmployee"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Localizer["CreateEmployeeAndAccount"]
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]
            </a>

        </div>

    </section>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="employee-create-card">

            <!-- أخطاء النموذج -->
            <div class="px-4 pt-4">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-0"
                     role="alert">
                </div>

            </div>

            <!-- بيانات الموظف -->
            <section class="employee-form-section">

                <div class="employee-section-heading">

                    <span class="employee-section-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <circle cx="12"
                                    cy="8"
                                    r="4" />

                            <path d="M4 21v-2a8 8 0 0 1 16 0v2" />

                        </svg>

                    </span>

                    <h2 class="employee-section-title">
                        @Localizer["Employees"]
                    </h2>

                </div>

                <div class="row g-4">

                    <!-- الاسم الكامل -->
                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">

                            @Localizer["FullName"]
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               autofocus />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- القسم -->
                    <div class="col-md-6">

                        <label asp-for="Department"
                               class="form-label">

                            @Localizer["Department"]
                        </label>

                        <input asp-for="Department"
                               class="form-control" />

                        <span asp-validation-for="Department"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <!-- بيانات الحساب -->
            <section class="employee-form-section">

                <div class="employee-section-heading">

                    <span class="employee-section-icon account">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <rect x="3"
                                  y="11"
                                  width="18"
                                  height="10"
                                  rx="2" />

                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />

                        </svg>

                    </span>

                    <h2 class="employee-section-title">
                        @Localizer["Login"]
                    </h2>

                </div>

                <div class="employee-account-notice">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="12"
                                cy="12"
                                r="9" />

                        <path d="M12 11v5" />
                        <path d="M12 8h.01" />

                    </svg>

                    <span>
                        @Localizer["CreateEmployeeAndAccount"]
                    </span>

                </div>

                <div class="row g-4">

                    <!-- البريد الإلكتروني -->
                    <div class="col-12">

                        <label asp-for="Email"
                               class="form-label">

                            @Localizer["Email"]
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               autocomplete="email"
                               dir="ltr" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- كلمة المرور -->
                    <div class="col-md-6">

                        <label asp-for="Password"
                               class="form-label">

                            @Localizer["Password"]
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               dir="ltr" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- تأكيد كلمة المرور -->
                    <div class="col-md-6">

                        <label asp-for="ConfirmPassword"
                               class="form-label">

                            @Localizer["ConfirmPassword"]
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               dir="ltr" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </section>

            <!-- الأزرار -->
            <div class="employee-form-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary px-4">

                    @Localizer["CreateEmployeeAndAccount"]
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]
                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}