@model EquipmentManagement.Domain.Entities.Category

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["CreateNewCategory"];
}

<div class="category-page category-theme-create">

    <section class="category-page-header mb-4">

        <div class="category-page-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="category-page-title mb-1">
                    @Localizer["CreateNewCategory"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Localizer["Categories"]
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="category-page-card">

            <div class="row g-0">

                <div class="col-md-4">

                    <div class="category-page-icon-area">

                        <span class="category-page-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">

                                <path d="M4 4h6v6H4z" />
                                <path d="M14 4h6v6h-6z" />
                                <path d="M4 14h6v6H4z" />
                                <path d="M14 14h6v6h-6z" />

                            </svg>

                        </span>

                    </div>

                </div>

                <div class="col-md-8">

                    <div class="category-page-content">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label">

                                @Localizer["Name"]

                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   autofocus />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div>

                            <label asp-for="Description"
                                   class="form-label">

                                @Localizer["Description"]

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="category-page-actions d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary px-4">

                    @Localizer["Save"]

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}