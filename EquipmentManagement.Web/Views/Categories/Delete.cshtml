@model EquipmentManagement.Domain.Entities.Category

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["DeleteCategory"];
}

<div class="category-page
            category-theme-delete
            category-read-page">

    <section class="category-page-header mb-4">

        <div class="category-page-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="category-page-title mb-1">
                    @Localizer["DeleteCategory"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <div class="category-delete-warning mb-4">

        <span class="category-delete-warning-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 aria-hidden="true">

                <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />

            </svg>

        </span>

        <div>

            <strong class="d-block mb-1">
                @Localizer["DeleteConfirmation"]
            </strong>

            <span>
                @Localizer["DeleteCategoryWarning"]
            </span>

        </div>

    </div>

    <section class="category-page-card">

        <div class="row g-0">

            <div class="col-md-4">

                <div class="category-page-icon-area">

                    <span class="category-page-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">

                            <path d="M3 6h18" />
                            <path d="M8 6V4h8v2" />
                            <path d="M19 6l-1 14H6L5 6" />
                            <path d="M10 11v5" />
                            <path d="M14 11v5" />

                        </svg>

                    </span>

                </div>

            </div>

            <div class="col-md-8">

                <div class="category-page-content">

                    <h2 class="category-page-name">
                        @Model.Name
                    </h2>

                    <dl class="category-page-list">

                        <div class="category-page-row">

                            <dt class="category-page-label">
                                @Localizer["Name"]
                            </dt>

                            <dd class="category-page-value fw-semibold">
                                @Model.Name
                            </dd>

                        </div>

                        <div class="category-page-row">

                            <dt class="category-page-label">
                                @Localizer["Description"]
                            </dt>

                            <dd class="category-page-value">

                                @(string.IsNullOrWhiteSpace(Model.Description)
                                    ? "-"
                                    : Model.Description)

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <div class="category-page-actions">

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-danger px-4"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteCategoryModal">

                    @Localizer["ConfirmDelete"]

                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-info px-4">

                    @Localizer["Details"]

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["Cancel"]

                </a>

            </div>

        </div>

    </section>

</div>

<!-- نافذة تأكيد الحذف -->
<div class="modal fade"
     id="deleteCategoryModal"
     tabindex="-1"
     aria-labelledby="deleteCategoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <form asp-action="Delete"
              method="post"
              class="modal-content category-delete-modal">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div class="modal-header category-delete-modal-header">

                <h2 class="modal-title h5 mb-0"
                    id="deleteCategoryModalLabel">

                    @Localizer["DeleteCategory"]

                </h2>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Cancel"]">
                </button>

            </div>

            <div class="modal-body p-4 text-center">

                <span class="category-delete-modal-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />

                    </svg>

                </span>

                <h3 class="h5 fw-bold mb-3">
                    @Localizer["DeleteConfirmation"]
                </h3>

                <p class="text-muted mb-3">
                    @Localizer["DeleteCategoryWarning"]
                </p>

                <div class="category-delete-modal-name">
                    @Model.Name
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary px-4"
                        data-bs-dismiss="modal">

                    @Localizer["Cancel"]

                </button>

                <button type="submit"
                        class="btn btn-danger px-4">

                    @Localizer["ConfirmDelete"]

                </button>

            </div>

        </form>

    </div>

</div>