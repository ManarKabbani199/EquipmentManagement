@model EquipmentManagement.Domain.Entities.Category

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["DeleteCategory"];
}
@{
    ViewData["Title"] = Localizer["DeleteCategory"];

    var deleteConfirmation =
        Localizer["DeleteConfirmation"].Value;
}


<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card border-danger shadow-sm">

            <div class="card-header bg-danger text-white">

                <h1 class="h4 mb-0">
                    @Localizer["DeleteCategory"]
                </h1>

            </div>

            <div class="card-body">

                <div class="alert alert-warning">

                    <strong>
                        @Localizer["DeleteConfirmation"]
                    </strong>

                    <div class="mt-2">
                        @Localizer["DeleteCategoryWarning"]
                    </div>

                </div>

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        @Localizer["Name"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-4">
                        @Localizer["Description"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Description
                    </dd>

                </dl>

            </div>

            <div class="card-footer">

               <form asp-action="Delete"  method="post"
                  onsubmit="return confirm('@deleteConfirmation');">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">

                            @Localizer["ConfirmDelete"]

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            @Localizer["Cancel"]

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>