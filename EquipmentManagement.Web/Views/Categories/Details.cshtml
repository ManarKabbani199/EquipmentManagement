@model EquipmentManagement.Domain.Entities.Category

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["CategoryDetails"];
}

<div class="category-page
            category-theme-details
            category-read-page">

    <section class="category-page-header mb-4">

        <div class="category-page-header-content
                    d-flex justify-content-between
                    align-items-center gap-3">

            <div>

                <h1 class="category-page-title mb-1">
                    @Localizer["CategoryDetails"]
                </h1>

                <p class="mb-0 text-white-50">
                    @Model.Name
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-light fw-semibold px-4">

                @Localizer["BackToList"]

            </a>

        </div>

    </section>

    <section class="category-page-card">

        <div class="row g-0">

            <div class="col-md-4">

                <div class="category-page-icon-area">

                    <span class="category-page-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">

                            <path d="M4 4h6v6H4z" />
                            <path d="M14 4h6v6h-6z" />
                            <path d="M4 14h6v6H4z" />
                            <path d="M14 14h6v6h-6z" />

                        </svg>

                    </span>

                </div>

            </div>

            <div class="col-md-8">

                <div class="category-page-content">

                    <h2 class="category-page-name">
                        @Model.Name
                    </h2>

                    <dl class="category-page-list">

                        <div class="category-page-row">

                            <dt class="category-page-label">
                                @Localizer["Name"]
                            </dt>

                            <dd class="category-page-value fw-semibold">
                                @Model.Name
                            </dd>

                        </div>

                        <div class="category-page-row">

                            <dt class="category-page-label">
                                @Localizer["Description"]
                            </dt>

                            <dd class="category-page-value">

                                @(string.IsNullOrWhiteSpace(Model.Description)
                                    ? "-"
                                    : Model.Description)

                            </dd>

                        </div>

                    </dl>

                </div>

            </div>

        </div>

        <div class="category-page-actions">

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning px-4">

                    @Localizer["Edit"]

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    @Localizer["BackToList"]

                </a>

            </div>

        </div>

    </section>

</div>