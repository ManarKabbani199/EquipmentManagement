@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization

@inject SignInManager<IdentityUser> SignInManager
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Home"];

    var isSignedIn =
        SignInManager.IsSignedIn(User);
}

<div class="home-page">

    <!-- القسم الرئيسي -->
    <section class="home-hero mb-5">

        <div class="home-hero-content">

            <span class="home-hero-badge">
                @Localizer["EquipmentManagementSystem"]
            </span>

            <h1 class="home-hero-title">
                @Localizer["WelcomeToEquipmentManagement"]
            </h1>

            <p class="home-hero-description">
                @Localizer["HomeSystemDescription"]
            </p>

            <div class="home-actions">

                @if (isSignedIn)
                {
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-light">

                        @Localizer["Dashboard"]
                    </a>

                    <a asp-controller="Equipment"
                       asp-action="Index"
                       class="btn btn-outline-light">

                        @Localizer["ViewEquipment"]
                    </a>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-light">

                        @Localizer["Login"]
                    </a>
                }

            </div>

        </div>

    </section>

    <!-- ميزات النظام -->
    <section class="mb-5">

        <div class="row g-4">

            <div class="col-md-4">

                <div class="home-feature-card">

                    <span class="home-feature-icon"
                          aria-hidden="true">
                        🖥️
                    </span>

                    <h2 class="home-feature-title">
                        @Localizer["EquipmentManagementFeature"]
                    </h2>

                    <p class="home-feature-description">
                        @Localizer[
                            "EquipmentManagementFeatureDescription"
                        ]
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="home-feature-card">

                    <span class="home-feature-icon"
                          aria-hidden="true">
                        🔄
                    </span>

                    <h2 class="home-feature-title">
                        @Localizer["BorrowingManagementFeature"]
                    </h2>

                    <p class="home-feature-description">
                        @Localizer[
                            "BorrowingManagementFeatureDescription"
                        ]
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="home-feature-card">

                    <span class="home-feature-icon"
                          aria-hidden="true">
                        👥
                    </span>

                    <h2 class="home-feature-title">
                        @Localizer["EmployeeManagementFeature"]
                    </h2>

                    <p class="home-feature-description">
                        @Localizer[
                            "EmployeeManagementFeatureDescription"
                        ]
                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- معلومات المطورة -->
    <section class="developer-card">

        <div class="developer-content">

            <span class="developer-label">
                @Localizer["DevelopedBy"]
            </span>

            <h2 class="developer-name">
                Manar Kabbani
            </h2>

            <p class="developer-description">
                @Localizer["DeveloperProfessionalDescription"]
            </p>

            <div class="developer-contact-list">

                <a href="tel:+96560955456"
                   class="developer-contact"
                   dir="ltr">

                    <span aria-hidden="true">☎</span>
                    <span>+965 60955456</span>

                </a>

                <a href="mailto:ManarKabbani2013@hotmail.com"
                   class="developer-contact"
                   dir="ltr">

                    <span aria-hidden="true">✉</span>
                    <span>ManarKabbani2013@hotmail.com</span>

                </a>

            </div>

        </div>

    </section>

</div>