@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EquipmentManagement.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AccessDenied"];
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card border-danger shadow-sm text-center">

            <div class="card-header bg-danger text-white">

                <h1 class="h4 mb-0">
                    @Localizer["AccessDenied"]
                </h1>

            </div>

            <div class="card-body py-5">

                <div class="mb-4"
                     style="font-size:4rem; line-height:1;">

                    ⛔

                </div>

                <h2 class="h5 mb-3">
                    @Localizer["AccessDenied"]
                </h2>

                <p class="text-muted mb-4">
                    @Localizer["AccessDeniedMessage"]
                </p>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">

                    @Localizer["ReturnHome"]

                </a>

            </div>

        </div>

    </div>

</div>