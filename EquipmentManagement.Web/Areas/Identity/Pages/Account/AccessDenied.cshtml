@page

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<EquipmentManagement.Web.SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["AccessDenied"];
}

<style>
    .access-denied-page {
        display: flex;
        min-height: 65vh;
        align-items: center;
        padding: 2rem 0;
    }

    .access-denied-card {
        position: relative;
        overflow: hidden;
        background: white;
        border: 1px solid #fecaca;
        border-radius: 1.25rem;
        box-shadow: 0 1rem 3rem rgba(127, 29, 29, 0.1);
    }

    .access-denied-visual {
        position: relative;
        display: flex;
        min-height: 28rem;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 2rem;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(255, 255, 255, 0.18),
                transparent 35%
            ),
            linear-gradient(135deg, #450a0a, #dc2626);
        text-align: center;
    }

    .access-denied-visual::before {
        content: "";
        position: absolute;
        inset-inline-end: -5rem;
        bottom: -5rem;
        width: 15rem;
        height: 15rem;
        border: 2rem solid rgba(255, 255, 255, 0.06);
        border-radius: 50%;
    }

    .access-denied-visual-content {
        position: relative;
        z-index: 1;
    }

    .access-denied-icon {
        display: inline-flex;
        width: 8rem;
        height: 8rem;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        color: white;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 50%;
    }

    .access-denied-icon svg {
        width: 4rem;
        height: 4rem;
    }

    .access-denied-code {
        margin: 0;
        font-size: 4rem;
        font-weight: 900;
        line-height: 1;
        opacity: 0.9;
    }

    .access-denied-content {
        display: flex;
        min-height: 28rem;
        align-items: center;
        padding: 2.5rem;
    }

    .access-denied-content-inner {
        width: 100%;
    }

    .access-denied-title {
        margin-bottom: 1rem;
        color: #0f172a;
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        font-weight: 800;
    }

    .access-denied-message {
        margin-bottom: 1.75rem;
        color: #64748b;
        line-height: 1.8;
    }

    .access-denied-notice {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        margin-bottom: 1.75rem;
        padding: 1rem;
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 0.8rem;
    }

    .access-denied-notice svg {
        width: 1.4rem;
        height: 1.4rem;
        flex: 0 0 1.4rem;
    }

    .access-denied-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    @@media (max-width: 767.98px) {
        .access-denied-page {
            min-height: auto;
            padding: 1rem 0;
        }

        .access-denied-visual {
            min-height: 14rem;
        }

        .access-denied-icon {
            width: 5.5rem;
            height: 5.5rem;
            margin-bottom: 1rem;
        }

        .access-denied-icon svg {
            width: 2.8rem;
            height: 2.8rem;
        }

        .access-denied-code {
            font-size: 2.5rem;
        }

        .access-denied-content {
            min-height: auto;
            padding: 1.5rem;
        }
    }

    @@media (max-width: 575.98px) {
        .access-denied-card {
            border-radius: 1rem;
        }

        .access-denied-actions {
            flex-direction: column;
        }

        .access-denied-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="access-denied-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-9">

                <section class="access-denied-card">

                    <div class="row g-0">

                        <!-- الجانب البصري -->
                        <div class="col-md-5">

                            <div class="access-denied-visual">

                                <div class="access-denied-visual-content">

                                    <span class="access-denied-icon">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <path d="M8 8l8 8" />

                                        </svg>

                                    </span>

                                    <p class="access-denied-code">
                                        403
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- الرسالة -->
                        <div class="col-md-7">

                            <div class="access-denied-content">

                                <div class="access-denied-content-inner">

                                    <h1 class="access-denied-title">
                                        @Localizer["AccessDenied"]
                                    </h1>

                                    <p class="access-denied-message">
                                        @Localizer["AccessDeniedMessage"]
                                    </p>

                                    <div class="access-denied-notice">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <path d="M12 11v5" />
                                            <path d="M12 8h.01" />

                                        </svg>

                                        <span>
                                            @Localizer["AccessDeniedMessage"]
                                        </span>

                                    </div>

                                    <div class="access-denied-actions">

                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <a asp-area=""
                                               asp-controller="Dashboard"
                                               asp-action="Index"
                                               class="btn btn-primary px-4">

                                                @Localizer["Dashboard"]
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-area=""
                                               asp-controller="Home"
                                               asp-action="Index"
                                               class="btn btn-primary px-4">

                                                @Localizer["ReturnHome"]
                                            </a>
                                        }

                                        <button type="button"
                                                class="btn btn-outline-secondary px-4"
                                                onclick="history.back();">

                                            @Localizer["BackToList"]
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </section>

            </div>

        </div>

    </div>

</div>