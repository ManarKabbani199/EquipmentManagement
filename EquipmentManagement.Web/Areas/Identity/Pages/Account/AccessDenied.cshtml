@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EquipmentManagement.Web.SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["AccessDenied"];
}

<div class="access-denied-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-9">

                <section class="access-denied-card">

                    <div class="row g-0">

                        <!-- الجانب البصري -->
                        <div class="col-md-5">

                            <div class="access-denied-visual">

                                <div class="access-denied-visual-content">

                                    <span class="access-denied-icon"
                                          aria-hidden="true">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <path d="M8 8l8 8" />

                                        </svg>

                                    </span>

                                    <p class="access-denied-code">
                                        403
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- الرسالة -->
                        <div class="col-md-7">

                            <div class="access-denied-content">

                                <div class="access-denied-content-inner">

                                    <h1 class="access-denied-title">
                                        @Localizer["AccessDenied"]
                                    </h1>

                                    <p class="access-denied-message">
                                        @Localizer["AccessDeniedMessage"]
                                    </p>

                                    <div class="access-denied-notice">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             aria-hidden="true">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <path d="M12 11v5" />
                                            <path d="M12 8h.01" />

                                        </svg>

                                        <span>
                                            @Localizer["AccessDeniedMessage"]
                                        </span>

                                    </div>

                                    <div class="access-denied-actions">

                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <a asp-area=""
                                               asp-controller="Dashboard"
                                               asp-action="Index"
                                               class="btn btn-primary px-4">

                                                @Localizer["Dashboard"]
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-area=""
                                               asp-controller="Home"
                                               asp-action="Index"
                                               class="btn btn-primary px-4">

                                                @Localizer["ReturnHome"]
                                            </a>
                                        }

                                        <button type="button"
                                                class="btn btn-outline-secondary px-4"
                                                onclick="history.back();">

                                            @Localizer["BackToList"]
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </section>

            </div>

        </div>

    </div>

</div>