@page
@model LoginModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EquipmentManagement.Web.SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["Login"];
}

<div class="login-page">

    <div class="row justify-content-center">

        <div class="col-xl-10">

            <div class="login-card">

                <div class="row g-0">

                    <!-- الجانب البصري -->
                    <div class="col-lg-6">

                        <section class="login-visual">

                            <div class="login-visual-content">

                                <span class="login-logo"
                                      aria-hidden="true">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                                        <path d="m3.3 7 8.7 5 8.7-5" />
                                        <path d="M12 22V12" />

                                    </svg>

                                </span>

                                <h1 class="login-visual-title">
                                    @Localizer["ApplicationName"]
                                </h1>

                                <p class="login-visual-description">
                                    @Localizer["LoginInstructions"]
                                </p>

                            </div>

                        </section>

                    </div>

                    <!-- نموذج تسجيل الدخول -->
                    <div class="col-lg-6">

                        <section class="login-form-area">

                            <div class="login-form-content">

                                <h2 class="login-form-title">
                                    @Localizer["Login"]
                                </h2>

                                <p class="login-form-description">
                                    @Localizer["LoginInstructions"]
                                </p>

                                <form id="account"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <div asp-validation-summary="ModelOnly"
                                         class="alert alert-danger"
                                         role="alert">
                                    </div>

                                    <!-- البريد الإلكتروني -->
                                    <div class="form-floating mb-3">

                                        <input asp-for="Input.Email"
                                               type="email"
                                               class="form-control"
                                               autocomplete="username"
                                               aria-required="true"
                                               placeholder="name@example.com"
                                               dir="ltr" />

                                        <label asp-for="Input.Email">
                                            @Localizer["Email"]
                                        </label>

                                    </div>

                                    <span asp-validation-for="Input.Email"
                                          class="text-danger small
                                                 d-block mb-3">
                                    </span>

                                    <!-- كلمة المرور -->
                                    <div class="form-floating mb-3">

                                        <input asp-for="Input.Password"
                                               type="password"
                                               class="form-control"
                                               autocomplete="current-password"
                                               aria-required="true"
                                               placeholder="Password"
                                               dir="ltr" />

                                        <label asp-for="Input.Password">
                                            @Localizer["Password"]
                                        </label>

                                    </div>

                                    <span asp-validation-for="Input.Password"
                                          class="text-danger small
                                                 d-block mb-3">
                                    </span>

                                    <!-- تذكر الحساب -->
                                    <div class="login-remember">

                                        <div class="form-check">

                                            <input asp-for="Input.RememberMe"
                                                   class="form-check-input" />

                                            <label asp-for="Input.RememberMe"
                                                   class="form-check-label">

                                                @Localizer["RememberMe"]
                                            </label>

                                        </div>

                                    </div>

                                    <button id="login-submit"
                                            type="submit"
                                            class="btn btn-primary
                                                   login-submit-button w-100">

                                        @Localizer["Login"]
                                    </button>

                                </form>

                            </div>

                        </section>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}