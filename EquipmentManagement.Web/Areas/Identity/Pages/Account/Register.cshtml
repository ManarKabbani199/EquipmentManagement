@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EquipmentManagement.Web.SharedResource> Localizer

@{
    ViewData["Title"] =
        Localizer["RegistrationDisabled"];
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card border-warning shadow-sm text-center">

            <div class="card-header bg-warning">

                <h1 class="h4 mb-0">
                    @Localizer["RegistrationDisabled"]
                </h1>

            </div>

            <div class="card-body py-5">

                <div class="mb-4"
                     style="font-size:4rem; line-height:1;">

                    🔒

                </div>

                <p class="text-muted mb-4">
                    @Localizer["RegistrationDisabledMessage"]
                </p>

                <a asp-page="./Login"
                   class="btn btn-primary">

                    @Localizer["Login"]

                </a>

            </div>

        </div>

    </div>

</div>